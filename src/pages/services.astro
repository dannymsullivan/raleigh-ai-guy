---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { servicePackages, workshopOffer } from "@/data/offers";
import { leakAuditHref } from "@/data/site";
---

<BaseLayout
  pageTitle="Services — Leak Audit, Fix & Launch, Growth on Autopilot"
  pageDescription="Danny Sullivan helps Raleigh businesses stop leaking leads. Start with a Leak Audit, then fix the site and Google listing or keep growth running each month."
>
  <section>
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid gap-7 border-t-[3px] border-black pt-6 lg:grid-cols-12 lg:items-end lg:gap-14">
        <div class="lg:col-span-8">
          <p class="print-stamp">Services · Raleigh</p>
          <h1 class="font-editorial mt-5 max-w-4xl text-6xl leading-[.88] sm:text-8xl">Hire the fix. Start with the leaks.</h1>
        </div>
        <div class="border-l-2 border-black pl-5 lg:col-span-4">
          <p class="text-base leading-7 text-base-600">Three packages, priced as a starting point. The Leak Audit is the way in. If you sign a bigger package within 30 days, the audit fee comes off the price.</p>
          <a class="site-cta mt-6" href={leakAuditHref}>Book a Leak Audit →</a>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="border-y-2 border-black">
    <Wrapper variant="wide" class="grid lg:grid-cols-3">
      {servicePackages.map((offer, index) => (
        <article class:list={["flex flex-col border-black p-6 sm:p-8", index < servicePackages.length - 1 && "border-b-2 lg:border-b-0 lg:border-r-2", offer.featured && "bg-[var(--brand-yellow)]"]}>
          <p class="field-label">{offer.featured ? "Entry offer" : "Package"}</p>
          <h2 class="font-editorial mt-4 text-5xl leading-[.9]">{offer.name}</h2>
          <p class="mt-4 font-['Instrument_Sans'] text-sm font-extrabold uppercase tracking-wide">{offer.price}</p>
          <p class="mt-1 text-sm font-bold text-base-700">{offer.cadence}</p>
          <p class="mt-5 text-base leading-7">{offer.summary}</p>
          <ul class="mt-5 grid list-disc gap-3 pl-5 text-sm leading-6 text-base-700">
            {offer.includes.map((item) => <li>{item}</li>)}
          </ul>
          {offer.note && <p class="mt-5 border-t-2 border-black pt-4 text-sm font-bold leading-6">{offer.note}</p>}
          <a class="site-cta mt-8 w-fit" href={`/contact/?package=${offer.id}#request`}>
            {offer.id === "leak-audit" ? "Book a Leak Audit" : "Request this package"} →
          </a>
        </article>
      ))}
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="wide" class="grid gap-6 py-14 sm:grid-cols-[1fr_auto] sm:items-center sm:py-16">
      <div>
        <p class="field-label">Also, for teams</p>
        <h2 class="font-editorial mt-3 text-5xl leading-[.92]">{workshopOffer.name}</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-base-600">{workshopOffer.summary} {workshopOffer.cadence}.</p>
      </div>
      <a class="site-cta" href="/contact/?package=workshop#request">Ask about a workshop →</a>
    </Wrapper>
  </section>
</BaseLayout>
