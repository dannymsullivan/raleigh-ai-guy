---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const process = [
  ["Find the bottleneck", "You show me where work gets stuck, repeated, or lost. I learn how the business operates and identify the strongest opportunity."],
  ["Design the right system", "We define the result, map the workflow, and choose the simplest technology that can produce it reliably."],
  ["Build it around your work", "I create the system around your real tools, people, and decisions—not a generic AI demo."],
  ["Measure and improve", "We track the time, capacity, or revenue it creates and keep improving the system as the business grows."],
];

const offers = [
  {
    id: "consulting",
    label: "Primary offer / 01",
    name: "Ongoing Consulting",
    price: "$2,500",
    cadence: "per month",
    fit: "For an owner who wants a practical partner—not another vendor to manage.",
    description: "We choose one meaningful business priority at a time. I help diagnose it, decide what is worth doing, and implement the useful parts alongside you. A typical engagement begins with a three-month focus.",
    boundary: "Strategy, working sessions, and defined implementation capacity are included. Major software builds, ad spend, and paid tools are scoped separately.",
    href: "/contact/?service=consulting",
    cta: "Ask about consulting",
  },
  {
    id: "local-presence",
    label: "Entry project / 02",
    name: "Local Presence Sprint",
    price: "$2,500",
    cadence: "one-time · from",
    fit: "For an established local business whose online presence does not match the quality of its work.",
    description: "A focused website or rebuild connected to Google Business Profile, local search fundamentals, analytics, and conversion tracking. It is the clearest low-risk way to start working together.",
    boundary: "The starting scope uses existing brand assets and client-provided photography. Larger sites, original identity work, ecommerce, and ongoing publishing are quoted separately.",
    href: "/small-business-growth/",
    cta: "See the sprint",
  },
  {
    id: "custom-systems",
    label: "Focused build / 03",
    name: "Custom Systems",
    price: "$7,500",
    cadence: "project · from",
    fit: "For a valuable workflow that has outgrown spreadsheets, handoffs, or disconnected tools.",
    description: "I design and build automations, command centers, and internal tools around the way your business actually operates, with clear human review points and ownership.",
    boundary: "The final scope and price follow a short discovery process. Ongoing consulting is available when the system is part of a broader set of priorities.",
    href: "/contact/?service=custom-system",
    cta: "Discuss a system",
  },
];
---

<BaseLayout pageTitle="Consulting, Local Presence & Custom Systems — Raleigh AI Guy" pageDescription="Three clear ways to work with Danny Sullivan: ongoing consulting, a local-presence sprint, or a scoped custom system for an established service business.">
  <PageIntro eyebrow="Ways to work together" title="Choose the smallest useful way to start." description="Consulting is the main relationship. A focused local-presence sprint is the easiest way in. Custom systems are for operational problems with enough value to justify a larger build." ctaHref="#offers" ctaLabel="See the three offers" />

  <section id="offers" class="border-b-[3px] border-black bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="mb-10 grid gap-6 lg:grid-cols-12">
        <p class="field-label lg:col-span-3">Three ways to buy</p>
        <div class="lg:col-span-7"><h2 class="font-editorial text-5xl leading-[.9] sm:text-6xl">Clear enough to choose. Flexible enough to solve the right problem.</h2></div>
      </div>
      <div class="grid border-l-2 border-t-2 border-black lg:grid-cols-3">
        {offers.map((offer, index) => (
          <article id={offer.id} class:list={["flex min-h-[34rem] scroll-mt-8 flex-col border-b-2 border-r-2 border-black p-6 sm:p-8", index === 0 && "bg-[var(--brand-orange)]", index === 1 && "bg-[var(--brand-yellow)]"]}>
            <p class="field-label">{offer.label}</p>
            <div class="mt-8">
              <h2 class="font-editorial text-5xl leading-[.9]">{offer.name}</h2>
              <p class="mt-6 font-editorial text-5xl leading-none">{offer.price}</p>
              <p class="field-label mt-2">{offer.cadence}</p>
            </div>
            <p class="mt-8 text-sm font-bold leading-6">{offer.fit}</p>
            <p class="mt-4 text-sm leading-6 text-black/65">{offer.description}</p>
            <p class="mt-5 border-l-2 border-black/30 pl-4 text-xs leading-5 text-black/60">{offer.boundary}</p>
            <a class="mt-auto inline-flex min-h-12 items-center justify-between border-2 border-black bg-[var(--brand-paper)] px-4 pt-1 text-xs font-black uppercase shadow-[4px_4px_0_var(--brand-ink)]" href={offer.href}>{offer.cta} <span>→</span></a>
          </article>
        ))}
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4"><p class="field-label">The process</p><h2 class="font-editorial mt-5 text-5xl leading-[.96]">From daily friction to a system your team can run.</h2><p class="mt-6 text-sm leading-6 text-base-600">You are close enough to the work to know something is off. My job is to find the leverage and build the fix.</p></div>
        <ol class="border-t border-black/15 lg:col-span-8">
          {process.map(([title, body], index) => <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_12rem_1fr] sm:gap-6"><span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span><h3 class="font-semibold">{title}</h3><p class="text-sm leading-6 text-base-600">{body}</p></li>)}
        </ol>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5"><p class="field-label text-white/50">How the work grows</p><h2 class="font-editorial mt-5 text-5xl leading-[.96]">Start with the bottleneck that matters most.</h2></div>
        <div class="lg:col-span-7">
          <p class="text-base leading-7 text-white/65">A sprint or system build can stand on its own. When the business has a continuing list of worthwhile priorities, ongoing consulting creates a steady rhythm for choosing, implementing, and measuring the next one.</p>
          <div class="mt-8 grid gap-px bg-white/15 sm:grid-cols-2">
            <div class="bg-[var(--brand-forest)] py-6 sm:pr-7"><p class="field-label text-white/45">Build when</p><p class="mt-3 text-sm font-semibold leading-6">The time returned, money protected, or new capacity makes the investment worthwhile.</p></div>
            <div class="border-t border-white/15 bg-[var(--brand-forest)] py-6 sm:border-l sm:border-t-0 sm:pl-7"><p class="field-label text-white/45">Simplify when</p><p class="mt-3 text-sm font-semibold leading-6">A process change or existing tool can solve the problem without custom software.</p></div>
          </div>
          <p class="mt-7 border-l-2 border-[var(--brand-orange)] pl-5 text-sm leading-6 text-white/65">I will recommend the simplest reliable answer—even when the right answer is a clearer process or an existing tool instead of a custom build.</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <ContactBand eyebrow="Start with the work itself" title="Bring me the bottleneck." description="Tell me what keeps falling through the cracks, taking too long, or requiring your constant attention. I’ll help you choose the smallest useful way to start." ctaHref="/contact/" ctaLabel="Get in touch" />
</BaseLayout>
