---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BoardVisual from '@/components/community-boards/BoardVisual.astro';
import LeadForm from '@/components/community-boards/LeadForm.astro';
import heroImage from '@/images/community-boards/board-restaurant-hero-community-v2.png';

const steps = [
  ['01', 'Tell me about your space', 'Share the venue, audience, brand, and where a daily board would be useful.'],
  ['02', 'I design it around you', 'Your venue identity leads. The community partner area stays clean and secondary.'],
  ['03', 'I curate the partners', 'A few complementary Raleigh businesses can be featured in one consistent, venue-approved style.'],
  ['04', 'We make and install it', 'Once approved, the board is produced and professionally installed.'],
];
const benefits = [
  ['Neighborhood fit', 'Be introduced inside local places that overlap with the customers you serve.'],
  ['Lasting visibility', 'Stay present in a familiar place after a digital ad has disappeared.'],
  ['Clean presentation', 'Every business uses the same simple black-and-white name and website treatment.'],
  ['Trackable response', 'Each board leads to its own location page, with visits and partner actions measured separately.'],
];
const faqs = [
  ['How is the board free?', 'Raleigh AI Guy is funding the founding rollout as a community relationship project. There is no purchase requirement, required consultation, or hidden sales meeting.'],
  ['Does the venue control the featured businesses?', 'Yes. The venue reviews the partner lineup. A business that conflicts with its standards or relationships will not be included.'],
  ['How many businesses appear?', 'The standard layout includes six compact community partner positions. Roughly three quarters of the board remains focused on the venue.'],
  ['What do the business placements look like?', 'They are intentionally simple and consistent: business name and website in a clean black-and-white system—not six clashing business-card ads. The layout stays open to any good local fit.'],
  ['Who creates the lettering?', 'The plan is to work with Raleigh-area chalk artists for the initial venue design and hand-lettering. Each artist will be credited on the board’s QR landing page, with a link to their work.'],
  ['Can a business request a location?', 'Yes. During the founding rollout, placements are matched by neighborhood, audience fit, venue approval, and availability.'],
  ['Can results be tracked?', 'Yes. Each board includes one discreet QR code that opens its location page. Board visits and individual business actions can be measured separately.'],
  ['What does a founding placement cost?', 'Founding community partner placements are complimentary. The goal is to create useful local connections and prove the format with real results.'],
  ['Who owns and maintains the board?', 'Ownership and maintenance details are confirmed in the venue agreement before production.'],
];
const schema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Raleigh Community Boards',
  provider: { '@type': 'Person', name: 'Danny Sullivan', url: 'https://raleighaiguy.com/' },
  areaServed: ['Raleigh', 'Cary', 'Apex', 'Wake Forest', 'Wake County'],
  description: 'Free custom specials boards for Raleigh-area venues, created by Raleigh AI Guy and supported by a curated group of local community partners.',
  url: 'https://raleighaiguy.com/community-boards/',
};
---

<BaseLayout pageTitle="Raleigh Community Boards" pageDescription="Free custom specials boards for Raleigh-area venues, created as a no-catch community relationship project by Raleigh AI Guy." socialImage={heroImage.src} socialImageAlt="A Raleigh Community Board inside a neighborhood restaurant" socialImageWidth={1536} socialImageHeight={1024}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class="community-boards">
    <section class="cb-paper border-b-2 border-[var(--brand-ink)]">
      <div class="site-shell grid min-h-[clamp(42rem,82vh,58rem)] items-center gap-10 py-12 lg:grid-cols-[.85fr_1.15fr] lg:py-16">
        <div class="field-reveal">
          <span class="print-stamp">Founding Raleigh locations now forming</span>
          <p class="mt-8 text-xs font-bold uppercase tracking-[.12em]">Free boards · Local impact</p>
          <h1 class="mt-3 text-[clamp(5.5rem,12vw,10rem)] leading-[.75]">Your board.<br/><span class="cb-yellow-line">On me.</span></h1>
          <p class="mt-8 max-w-xl text-base leading-7 text-[var(--brand-muted)] sm:text-lg">I design, produce, and install a custom specials board in your venue for <strong class="text-[var(--brand-ink)]">$0.</strong> No required consultation and no hidden pitch—just something useful for a great local business.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="brand-button" href="#venue-form">Get a free board →</a><a class="cb-button-light" href="#advertiser-form">Join as a local partner</a></div>
          <p class="mt-8 text-[.68rem] font-bold uppercase tracking-[.05em] text-[var(--brand-muted)]">✓ Custom designed &nbsp; ✓ Professionally installed &nbsp; ✓ Venue-approved partners</p>
        </div>
        <div class="relative field-reveal field-reveal-delay lg:-mr-10">
          <span class="absolute -left-5 top-8 z-10 hidden -rotate-3 border-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] px-4 py-3 text-[.65rem] font-bold uppercase shadow-[4px_4px_0_var(--brand-ink)] md:block">Useful signage<br/>meets local media</span>
          <Image src={heroImage} alt="Concept of a Raleigh Community Board installed in a restaurant" class="aspect-[3/2] w-full border-2 border-[var(--brand-ink)] object-cover shadow-[9px_9px_0_var(--brand-ink)] lg:min-h-[37rem]" widths={[640,960,1280,1536]} sizes="(min-width:1024px) 55vw, 100vw" loading="eager" />
          <p class="mt-4 text-right text-[.58rem] font-bold uppercase tracking-[.08em] text-[var(--brand-muted)]">Concept image · final boards customized per venue</p>
        </div>
      </div>
    </section>

    <section class="bg-[var(--brand-ink)] text-[var(--brand-paper)]"><div class="site-shell grid divide-y divide-white/20 md:grid-cols-3 md:divide-x md:divide-y-0">
      <div class="py-7 md:px-7 md:first:pl-0"><b class="cb-kicker">For venues</b><p class="mt-2 font-bold">A useful custom board. Zero cost.</p></div>
      <div class="py-7 md:px-7"><b class="cb-kicker">For local businesses</b><p class="mt-2 font-bold">A complimentary place to build recognition.</p></div>
      <div class="py-7 md:px-7"><b class="cb-kicker">For Raleigh</b><p class="mt-2 font-bold">More local support for local places.</p></div>
    </div></section>

    <section id="how-it-works" class="cb-paper py-22 md:py-30"><div class="site-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
      <div class="lg:sticky lg:top-10 lg:self-start"><p class="site-eyebrow">How it works</p><h2 class="cb-heading">Four steps.<br/><span class="cb-yellow-line">No catch.</span></h2><p class="mt-6 max-w-sm text-sm leading-6 text-[var(--brand-muted)]">The venue gets something genuinely useful. Local partners get a tasteful introduction. I cover and coordinate the details.</p></div>
      <div class="grid gap-4 sm:grid-cols-2">{steps.map(([n,title,copy]) => <article class="print-panel flex min-h-70 flex-col p-6"><span class="font-editorial text-5xl text-[var(--brand-orange)]">{n}</span><h3 class="mt-auto font-editorial text-4xl leading-none uppercase">{title}</h3><p class="mt-4 text-sm leading-6 text-[var(--brand-muted)]">{copy}</p></article>)}</div>
    </div></section>

    <section class="border-y-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] py-22 md:py-28"><div class="site-shell grid items-center gap-14 lg:grid-cols-[.85fr_1.15fr]">
      <div class="mx-auto w-full max-w-md px-6"><BoardVisual venue="YOUR LOGO HERE" label="MADE FOR" tilt="left" /></div>
      <div><p class="site-eyebrow !text-[var(--brand-ink)]">For venue owners</p><h2 class="cb-heading">The board you needed.<br/><span class="cb-pink-line">The invoice you didn’t.</span></h2><p class="mt-7 max-w-xl leading-7">Turn an empty wall into a useful daily touchpoint without adding another line item.</p><ul class="mt-8 grid gap-3 text-sm font-bold sm:grid-cols-2">{['Reusable writing surface','Custom venue branding','Durable professional build','Compact partner layout','Venue approval of partners','Coordinated installation'].map(x => <li>■ {x}</li>)}</ul><a class="cb-button-light mt-9" href="#venue-form">Request your board ↓</a></div>
    </div></section>

    <section class="bg-[var(--brand-ink)] py-22 text-[var(--brand-paper)] md:py-30"><div class="site-shell">
      <div class="grid items-end gap-8 lg:grid-cols-2"><div><p class="cb-kicker">For community partners</p><h2 class="cb-heading">Stay in the room.<br/><span class="cb-yellow-line">Not the feed.</span></h2></div><p class="max-w-xl leading-7 text-white/65">Get a tasteful, complimentary presence inside neighborhood places your future customers already know and trust.</p></div>
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{benefits.map(([title,copy],i) => <article class="border-t-2 border-white/25 pt-5"><span class="font-editorial text-4xl text-[var(--brand-orange)]">0{i+1}</span><h3 class="mt-8 text-sm font-bold uppercase">{title}</h3><p class="mt-3 text-sm leading-6 text-white/55">{copy}</p></article>)}</div>
    </div></section>

    <section class="border-b-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] py-22 md:py-28"><div class="site-shell grid items-center gap-12 lg:grid-cols-[1fr_.8fr]">
      <div><p class="site-eyebrow">Built to be measurable</p><h2 class="cb-heading">One clean scan.<br/><span class="cb-pink-line">Real local results.</span></h2><p class="mt-7 max-w-2xl text-base leading-7 text-[var(--brand-muted)]">Each installed board gets one unique QR code—not a clutter of tiny codes. It opens a mobile page for that location, where visitors can see venue details and discover every community partner.</p><div class="mt-8 grid gap-4 sm:grid-cols-3">{[['01','Scan the board'],['02','Explore the page'],['03','Tap, call or visit']].map(([n,label]) => <div class="border-t-2 border-[var(--brand-ink)] pt-4"><b class="font-editorial text-3xl text-[var(--brand-orange)]">{n}</b><p class="mt-2 text-sm font-bold uppercase">{label}</p></div>)}</div><p class="mt-7 max-w-xl text-sm leading-6 text-[var(--brand-muted)]">The reporting focuses on decisions: board visits, unique visitors, partner profile taps, venue actions, and trends over time.</p></div>
      <div class="print-panel mx-auto w-full max-w-md p-5 shadow-[8px_8px_0_var(--brand-ink)]"><div class="border-2 border-[var(--brand-ink)] bg-white p-5"><div class="flex items-center justify-between border-b-2 border-[var(--brand-ink)] pb-4"><div><p class="text-[.58rem] font-bold uppercase tracking-[.1em] text-[var(--brand-muted)]">Sample reporting · demo data</p><p class="mt-1 font-editorial text-3xl uppercase">Your neighborhood board</p></div><div class="grid h-16 w-16 place-items-center border-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] text-center text-[.62rem] font-black leading-tight">UNIQUE<br/>QR</div></div><div class="mt-5 grid grid-cols-2 gap-2">{[['127','Board visits'],['94','Unique visitors'],['31','Partner taps'],['18','Venue actions']].map(([value,label]) => <div class="border border-[var(--brand-ink)] p-3"><b class="font-editorial text-4xl leading-none">{value}</b><p class="mt-2 text-[.55rem] font-bold uppercase tracking-[.06em] text-[var(--brand-muted)]">{label}</p></div>)}</div><p class="mt-5 text-[.58rem] font-bold uppercase tracking-[.08em] text-[var(--brand-muted)]">Illustrative preview · live boards report actual activity</p></div></div>
    </div></section>

    <section id="samples" class="py-22 md:py-30"><div class="site-shell grid items-center gap-14 lg:grid-cols-[.82fr_1.18fr]">
      <div class="mx-auto w-full max-w-md px-6"><BoardVisual venue="YOUR LOGO HERE" label="CUSTOM SPECIALS FOR" tilt="right" /></div>
      <div><p class="site-eyebrow">A generic example</p><h2 class="cb-heading">Your identity.<br/><span class="cb-yellow-line">Your daily message.</span></h2><p class="mt-7 max-w-2xl leading-7 text-[var(--brand-muted)]">Every finished board is designed for one venue. Your logo and writable space stay prominent; the community partner area remains compact, consistent, and secondary.</p><div class="mt-9 grid gap-4 sm:grid-cols-2">{[['01','Venue-first design','The top of the board is hand-lettered around the place hosting it.'],['02','Reusable liquid-chalk surface','Update specials, classes, events, flavors, or service reminders with a damp-cloth reset.'],['03','Six flexible partner spots','Only the business name and website are written in each reusable position—no industry restrictions.'],['04','One tracked QR','The location page measures activity and credits the local artist who lettered the board.']].map(([n,title,copy]) => <article class="border-t-2 border-[var(--brand-ink)] pt-4"><span class="font-editorial text-3xl text-[var(--brand-orange)]">{n}</span><h3 class="mt-4 text-sm font-bold uppercase">{title}</h3><p class="mt-2 text-sm leading-6 text-[var(--brand-muted)]">{copy}</p></article>)}</div><div class="mt-9 flex flex-col gap-3 sm:flex-row"><a class="brand-button" href="#venue-form">Get a free board →</a><a class="cb-button-light" href="#advertiser-form">Join as a local partner</a></div></div>
    </div></section>

    <section class="py-22 md:py-30"><div class="site-shell grid gap-12 lg:grid-cols-[.55fr_1fr]"><div><p class="site-eyebrow">Questions, answered</p><h2 class="cb-heading">The useful fine print.</h2></div><div class="grid gap-3">{faqs.map(([q,a],i) => <details class="group border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] px-5" open={i===0}><summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3 font-bold"><span>{q}</span><span class="text-2xl text-[var(--brand-orange)] group-open:rotate-45">+</span></summary><p class="pb-5 text-sm leading-6 text-[var(--brand-muted)]">{a}</p></details>)}</div></div></section>

    <section class="border-t-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] py-22 md:py-28"><div class="site-shell"><div class="max-w-4xl"><p class="site-eyebrow !text-[var(--brand-ink)]">Founding applications</p><h2 class="cb-heading">Pick your side<br/>of the board.</h2><p class="mt-6 max-w-2xl text-sm leading-6">Venue owners can request a free board. Raleigh businesses can request a complimentary founding partner position.</p></div><div class="mt-12 grid gap-10 xl:grid-cols-2 xl:items-start"><LeadForm type="venue" /><LeadForm type="advertiser" /></div></div></section>
  </div>
</BaseLayout>

<style is:global>
  .community-boards .cb-paper { background-color:var(--brand-bg); background-image:radial-gradient(rgb(23 19 15 / 8%) .7px,transparent .8px); background-size:8px 8px; }
  .community-boards .cb-heading { margin-top:1rem; font-size:clamp(4.5rem,9vw,7rem); line-height:.82; }
  .community-boards .cb-yellow-line { text-decoration:underline; text-decoration-color:var(--brand-yellow); text-decoration-thickness:.09em; text-underline-offset:.04em; }
  .community-boards .cb-pink-line { text-decoration:underline; text-decoration-color:var(--brand-orange); text-decoration-thickness:.08em; text-underline-offset:.04em; }
  .community-boards .cb-kicker { color:var(--brand-yellow); font-size:.62rem; letter-spacing:.1em; text-transform:uppercase; }
  .community-boards .cb-button-light { display:inline-flex; min-height:2.75rem; align-items:center; justify-content:center; border:2px solid var(--brand-ink); padding-inline:1rem; color:var(--brand-ink); background:var(--brand-surface); box-shadow:4px 4px 0 var(--brand-ink); font-family:"Instrument Sans",sans-serif; font-size:.78rem; font-weight:800; text-transform:uppercase; transition:140ms; }
  .community-boards .cb-button-light:hover { transform:translate(2px,2px); box-shadow:2px 2px 0 var(--brand-ink); }
  .community-boards details summary::-webkit-details-marker { display:none; }
</style>
