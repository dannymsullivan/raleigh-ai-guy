---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BoardVisual from '@/components/community-boards/BoardVisual.astro';
import InventoryGrid from '@/components/community-boards/InventoryGrid.astro';
import LeadForm from '@/components/community-boards/LeadForm.astro';
import heroImage from '@/images/community-boards/board-restaurant-hero.png';
import referenceImage from '@/images/community-boards/board-reference.jpg';

const steps = [
  ['01', 'Tell me about your space', 'Share the venue, audience, brand, and where a daily board would be useful.'],
  ['02', 'I design it around you', 'Your venue identity leads. The sponsor area stays clean and secondary.'],
  ['03', 'Local sponsors fund it', 'I assemble complementary Raleigh businesses for your approval.'],
  ['04', 'We make and install it', 'Once approved, the board is produced and professionally installed.'],
];
const benefits = [
  ['Neighborhood fit', 'Choose areas and venue types that overlap with the customers you serve.'],
  ['Lasting visibility', 'Stay present in a familiar place after a digital ad has disappeared.'],
  ['Category protection', 'The goal is one sponsor per business category on each board.'],
  ['Trackable response', 'A unique QR code and campaign destination can be built into your placement.'],
];
const faqs = [
  ['How is the board free?', 'A small group of local businesses sponsors the placements along the bottom. Their sponsorship covers design, production, and installation.'],
  ['Does the venue control the advertisers?', 'Yes. The venue reviews sponsor categories before production. A business that conflicts with its standards or relationships will not be placed.'],
  ['How many ads appear?', 'Most concepts use six to eight placements. The reusable writing area remains the focus.'],
  ['Is advertising category-exclusive?', 'The goal is one sponsor per business category on each board, subject to availability.'],
  ['Can advertisers choose locations?', 'Yes. Sponsors can request one board, a neighborhood mix, or a broader Raleigh-area package.'],
  ['Can results be tracked?', 'Sponsor artwork can include a unique QR code and campaign URL.'],
  ['How much does advertising cost?', 'Pricing depends on location mix, board size, term, and number of placements.'],
  ['Who owns and maintains the board?', 'Ownership and maintenance details are confirmed in the venue agreement before production.'],
];
const schema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Raleigh Community Boards',
  provider: { '@type': 'Person', name: 'Danny Sullivan', url: 'https://raleighaiguy.com/' },
  areaServed: ['Raleigh', 'Cary', 'Apex', 'Wake Forest', 'Wake County'],
  description: 'Sponsor-funded custom specials boards for Raleigh-area venues and local advertisers.',
  url: 'https://raleighaiguy.com/community-boards/',
};
---

<BaseLayout pageTitle="Raleigh Community Boards" pageDescription="Free custom specials boards for Raleigh-area venues, funded by local businesses that want lasting neighborhood visibility." socialImage={heroImage.src} socialImageAlt="A Raleigh Community Board inside a neighborhood restaurant" socialImageWidth={1536} socialImageHeight={1024}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class="community-boards">
    <section class="cb-paper border-b-2 border-[var(--brand-ink)]">
      <div class="site-shell grid min-h-[clamp(42rem,82vh,58rem)] items-center gap-10 py-12 lg:grid-cols-[.85fr_1.15fr] lg:py-16">
        <div class="field-reveal">
          <span class="print-stamp">Founding Raleigh locations now forming</span>
          <p class="mt-8 text-xs font-bold uppercase tracking-[.12em]">Free boards · Local impact</p>
          <h1 class="mt-3 text-[clamp(5.5rem,12vw,10rem)] leading-[.75]">Your board.<br/><span class="cb-yellow-line">On me.</span></h1>
          <p class="mt-8 max-w-xl text-base leading-7 text-[var(--brand-muted)] sm:text-lg">I design and install a custom specials board in your venue for <strong class="text-[var(--brand-ink)]">$0.</strong> A small group of Raleigh businesses funds it in exchange for clean, lasting visibility.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="brand-button" href="#venue-form">Get a free board →</a><a class="cb-button-light" href="#advertiser-form">Advertise on a board</a></div>
          <p class="mt-8 text-[.68rem] font-bold uppercase tracking-[.05em] text-[var(--brand-muted)]">✓ Custom designed &nbsp; ✓ Professionally installed &nbsp; ✓ Venue-approved sponsors</p>
        </div>
        <div class="relative field-reveal field-reveal-delay lg:-mr-10">
          <span class="absolute -left-5 top-8 z-10 hidden -rotate-3 border-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] px-4 py-3 text-[.65rem] font-bold uppercase shadow-[4px_4px_0_var(--brand-ink)] md:block">Useful signage<br/>meets local media</span>
          <Image src={heroImage} alt="Concept of a Raleigh Community Board installed in a restaurant" class="aspect-[3/2] w-full border-2 border-[var(--brand-ink)] object-cover shadow-[9px_9px_0_var(--brand-ink)] lg:min-h-[37rem]" widths={[640,960,1280,1536]} sizes="(min-width:1024px) 55vw, 100vw" loading="eager" />
          <p class="mt-4 text-right text-[.58rem] font-bold uppercase tracking-[.08em] text-[var(--brand-muted)]">Concept image · final boards customized per venue</p>
        </div>
      </div>
    </section>

    <section class="bg-[var(--brand-ink)] text-[var(--brand-paper)]"><div class="site-shell grid divide-y divide-white/20 md:grid-cols-3 md:divide-x md:divide-y-0">
      <div class="py-7 md:px-7 md:first:pl-0"><b class="cb-kicker">For venues</b><p class="mt-2 font-bold">A useful custom board. Zero cost.</p></div>
      <div class="py-7 md:px-7"><b class="cb-kicker">For local businesses</b><p class="mt-2 font-bold">A trusted place to stay visible.</p></div>
      <div class="py-7 md:px-7"><b class="cb-kicker">For Raleigh</b><p class="mt-2 font-bold">More local support for local places.</p></div>
    </div></section>

    <section id="how-it-works" class="cb-paper py-22 md:py-30"><div class="site-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
      <div class="lg:sticky lg:top-10 lg:self-start"><p class="site-eyebrow">How it works</p><h2 class="cb-heading">Four steps.<br/><span class="cb-yellow-line">No catch.</span></h2><p class="mt-6 max-w-sm text-sm leading-6 text-[var(--brand-muted)]">Venues keep control. Sponsors get a real-world presence. I coordinate the details.</p></div>
      <div class="grid gap-4 sm:grid-cols-2">{steps.map(([n,title,copy]) => <article class="print-panel flex min-h-70 flex-col p-6"><span class="font-editorial text-5xl text-[var(--brand-orange)]">{n}</span><h3 class="mt-auto font-editorial text-4xl leading-none uppercase">{title}</h3><p class="mt-4 text-sm leading-6 text-[var(--brand-muted)]">{copy}</p></article>)}</div>
    </div></section>

    <section class="border-y-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] py-22 md:py-28"><div class="site-shell grid items-center gap-14 lg:grid-cols-[.85fr_1.15fr]">
      <div class="mx-auto w-full max-w-md px-6"><BoardVisual venue="YOUR VENUE" label="MADE FOR" tilt="left" /></div>
      <div><p class="site-eyebrow !text-[var(--brand-ink)]">For venue owners</p><h2 class="cb-heading">The board you needed.<br/><span class="cb-pink-line">The invoice you didn’t.</span></h2><p class="mt-7 max-w-xl leading-7">Turn an empty wall into a useful daily touchpoint without adding another line item.</p><ul class="mt-8 grid gap-3 text-sm font-bold sm:grid-cols-2">{['Reusable writing surface','Custom venue branding','Durable professional build','Clean sponsor layout','Venue approval of sponsors','Coordinated installation'].map(x => <li>■ {x}</li>)}</ul><a class="cb-button-light mt-9" href="#venue-form">Request your board ↓</a></div>
    </div></section>

    <section class="bg-[var(--brand-ink)] py-22 text-[var(--brand-paper)] md:py-30"><div class="site-shell">
      <div class="grid items-end gap-8 lg:grid-cols-2"><div><p class="cb-kicker">For local advertisers</p><h2 class="cb-heading">Stay in the room.<br/><span class="cb-yellow-line">Not the feed.</span></h2></div><p class="max-w-xl leading-7 text-white/65">Put your business inside neighborhood places your future customers already know and trust.</p></div>
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{benefits.map(([title,copy],i) => <article class="border-t-2 border-white/25 pt-5"><span class="font-editorial text-4xl text-[var(--brand-orange)]">0{i+1}</span><h3 class="mt-8 text-sm font-bold uppercase">{title}</h3><p class="mt-3 text-sm leading-6 text-white/55">{copy}</p></article>)}</div>
    </div></section>

    <section id="samples" class="py-22 md:py-30"><div class="site-shell">
      <div class="grid gap-6 lg:grid-cols-[1fr_.7fr] lg:items-end"><div><p class="site-eyebrow">Sample boards</p><h2 class="cb-heading">Made for the room.</h2></div><p class="text-sm leading-6 text-[var(--brand-muted)]">These examples show the concept—not current customers. You’ll help choose the real Raleigh businesses featured next.</p></div>
      <div class="mt-12 grid gap-6 md:grid-cols-3"><div class="cb-sample bg-[var(--brand-orange)]"><BoardVisual venue="THE CORNER SLICE" label="PIZZA · PASTA · PEOPLE" tilt="left" /><b>Pizza restaurant concept</b></div><div class="cb-sample bg-[var(--brand-yellow)]"><BoardVisual venue="OAK CITY COFFEE" label="TODAY AT" /><b>Coffee shop concept</b></div><div class="cb-sample bg-[var(--brand-surface-soft)]"><BoardVisual venue="TRIANGLE TAPROOM" label="ON TAP" tilt="right" /><b>Brewery concept</b></div></div>
      <div class="mt-6 grid items-center gap-7 border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] p-5 shadow-[6px_6px_0_var(--brand-ink)] md:grid-cols-[.72fr_1.28fr] md:p-7"><Image src={referenceImage} alt="Original real-world advertiser board reference" class="max-h-[31rem] w-full border-2 border-[var(--brand-ink)] object-cover" widths={[480,720,960]} sizes="(min-width:768px) 40vw, 100vw" /><div class="md:p-8"><span class="print-stamp">Original reference</span><h3 class="mt-7 font-editorial text-5xl leading-[.9] uppercase md:text-6xl">A proven format, refined for Raleigh.</h3><p class="mt-5 text-sm leading-6 text-[var(--brand-muted)]">This has the essentials: a generous reusable surface and durable sponsor placements. The new concept gives it a cleaner finish and uses Raleigh AI Guy as the house sponsor while real local businesses are selected.</p></div></div>
    </div></section>

    <section id="locations" class="cb-paper border-y-2 border-[var(--brand-ink)] py-22 md:py-28"><div class="site-shell"><div class="grid gap-6 lg:grid-cols-[1fr_.7fr] lg:items-end"><div><p class="site-eyebrow">Launch map</p><h2 class="cb-heading">Available next.</h2></div><p class="text-sm leading-6 text-[var(--brand-muted)]">These cards are demo inventory for planning. No venue is represented as confirmed.</p></div><div class="mt-10"><InventoryGrid /></div></div></section>

    <section class="py-22 md:py-30"><div class="site-shell grid gap-12 lg:grid-cols-[.55fr_1fr]"><div><p class="site-eyebrow">Questions, answered</p><h2 class="cb-heading">The useful fine print.</h2></div><div class="grid gap-3">{faqs.map(([q,a],i) => <details class="group border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] px-5" open={i===0}><summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3 font-bold"><span>{q}</span><span class="text-2xl text-[var(--brand-orange)] group-open:rotate-45">+</span></summary><p class="pb-5 text-sm leading-6 text-[var(--brand-muted)]">{a}</p></details>)}</div></div></section>

    <section class="border-t-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] py-22 md:py-28"><div class="site-shell"><div class="max-w-4xl"><p class="site-eyebrow !text-[var(--brand-ink)]">Founding applications</p><h2 class="cb-heading">Pick your side<br/>of the board.</h2><p class="mt-6 max-w-2xl text-sm leading-6">Venue owners can request a free board. Raleigh businesses can request sponsor details.</p></div><div class="mt-12 grid gap-10 xl:grid-cols-2 xl:items-start"><LeadForm type="venue" /><LeadForm type="advertiser" /></div></div></section>
  </div>
</BaseLayout>

<style is:global>
  .community-boards .cb-paper { background-color:var(--brand-bg); background-image:radial-gradient(rgb(23 19 15 / 8%) .7px,transparent .8px); background-size:8px 8px; }
  .community-boards .cb-heading { margin-top:1rem; font-size:clamp(4.5rem,9vw,7rem); line-height:.82; }
  .community-boards .cb-yellow-line { text-decoration:underline; text-decoration-color:var(--brand-yellow); text-decoration-thickness:.09em; text-underline-offset:.04em; }
  .community-boards .cb-pink-line { text-decoration:underline; text-decoration-color:var(--brand-orange); text-decoration-thickness:.08em; text-underline-offset:.04em; }
  .community-boards .cb-kicker { color:var(--brand-yellow); font-size:.62rem; letter-spacing:.1em; text-transform:uppercase; }
  .community-boards .cb-button-light { display:inline-flex; min-height:2.75rem; align-items:center; justify-content:center; border:2px solid var(--brand-ink); padding-inline:1rem; color:var(--brand-ink); background:var(--brand-surface); box-shadow:4px 4px 0 var(--brand-ink); font-family:"Instrument Sans",sans-serif; font-size:.78rem; font-weight:800; text-transform:uppercase; transition:140ms; }
  .community-boards .cb-button-light:hover { transform:translate(2px,2px); box-shadow:2px 2px 0 var(--brand-ink); }
  .community-boards .cb-sample { border:2px solid var(--brand-ink); padding:1.5rem; }
  .community-boards .cb-sample > b { display:block; margin-top:1.5rem; font-size:.7rem; text-transform:uppercase; }
  .community-boards details summary::-webkit-details-marker { display:none; }
</style>
