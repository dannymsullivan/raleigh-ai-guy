---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BoardVisual from '@/components/community-boards/BoardVisual.astro';
import heroImage from '@/images/community-boards/board-restaurant-hero-community-v2.png';
import periBrothersImage from '@/images/community-boards/venue-concepts/peri-brothers-specials-community-v2.png';
import twoRoostersImage from '@/images/community-boards/venue-concepts/two-roosters-specials-community-v2.png';
import solaCoffeeImage from '@/images/community-boards/venue-concepts/sola-coffee-community-v2.png';
import noraCafeImage from '@/images/community-boards/venue-concepts/nora-cafe-specials-community-v2.png';

const examples = [
  { name: 'Two Roosters', type: 'Ice cream shop', image: twoRoostersImage },
  { name: 'Peri Brothers', type: 'Pizza & pasta', image: periBrothersImage },
  { name: 'Sola Coffee', type: 'Coffee shop', image: solaCoffeeImage },
  { name: 'NoRa Cafe', type: 'Coffee shop', image: noraCafeImage },
];

const faqs = [
  ['What is free for 90 days?', 'A local business receives one hand-lettered community partner position for 90 days at no cost. At the end, it can choose an optional paid renewal or rotate out.'],
  ['What does the venue pay?', 'Nothing. I coordinate the reusable board, local artist, QR page, production, and installation. The venue approves the design and every featured business.'],
  ['Is there a contract?', 'The 90-day partner pilot has no paid contract, automatic billing, or automatic renewal. Venues simply confirm practical placement, care, and removal terms before installation.'],
  ['How is attention measured?', 'We show three distinct layers: estimated venue foot traffic, reported or tagged social sharing and reach, and directly measured QR visits and actions.'],
  ['Who creates the artwork?', 'Raleigh-area chalk artists create the initial hand-lettering and receive credit and a link on each board’s QR page.'],
  ['What appears in a partner spot?', 'Only the business name appears on the board in one consistent liquid-chalk style. The shared QR page carries websites, phone numbers, and trackable actions.'],
];

const schema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Raleigh Community Boards',
  provider: { '@type': 'Person', name: 'Danny Sullivan', url: 'https://raleighaiguy.com/' },
  areaServed: ['Raleigh', 'Cary', 'Apex', 'Wake Forest', 'Wake County'],
  description: 'Hand-lettered community boards connecting Raleigh venues, local artists, and local businesses through complimentary 90-day placements.',
  url: 'https://raleighaiguy.com/community-boards/',
};
---

<BaseLayout pageTitle="Raleigh Community Boards" pageDescription="Free hand-lettered boards for Raleigh venues and complimentary 90-day community partner placements for local businesses." socialImage={heroImage.src} socialImageAlt="A Raleigh Community Board inside a neighborhood restaurant" socialImageWidth={1536} socialImageHeight={1024}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class="community-boards">
    <section class="cb-paper border-b-2 border-[var(--brand-ink)]">
      <div class="site-shell grid min-h-[clamp(42rem,82vh,58rem)] items-center gap-10 py-12 lg:grid-cols-[.85fr_1.15fr] lg:py-16">
        <div class="field-reveal">
          <span class="print-stamp">A deliberately human idea from the Raleigh AI Guy</span>
          <p class="mt-8 text-xs font-bold uppercase tracking-[.12em]">Free boards · Local artists · Trackable attention</p>
          <h1 class="mt-3 text-[clamp(5.5rem,12vw,10rem)] leading-[.75]">Your board.<br/><span class="cb-yellow-line">On me.</span></h1>
          <p class="mt-8 max-w-xl text-lg leading-8 text-[var(--brand-muted)]">Hand-lettered community boards placed inside busy Raleigh businesses. Venues get useful signage for <strong class="text-[var(--brand-ink)]">$0.</strong> Local businesses get <strong class="text-[var(--brand-ink)]">90 days of visibility free.</strong></p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="brand-button" href="#join">Choose your side →</a><a class="cb-button-light" href="#examples">See examples</a></div>
          <p class="mt-7 text-[.64rem] font-bold uppercase tracking-[.06em] text-[var(--brand-muted)]">No automatic renewal · No surprise invoice · Continue only if it works</p>
        </div>
        <div class="relative field-reveal field-reveal-delay lg:-mr-10"><span class="absolute -left-5 top-8 z-10 hidden -rotate-3 border-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] px-4 py-3 text-[.65rem] font-bold uppercase shadow-[4px_4px_0_var(--brand-ink)] md:block">The opposite of<br/>another digital ad</span><Image src={heroImage} alt="Concept of a Raleigh Community Board installed in a restaurant" class="aspect-[3/2] w-full border-2 border-[var(--brand-ink)] object-cover shadow-[9px_9px_0_var(--brand-ink)] lg:min-h-[37rem]" widths={[640,960,1280,1536]} sizes="(min-width:1024px) 55vw, 100vw" loading="eager"/><p class="mt-4 text-right text-[.58rem] font-bold uppercase tracking-[.08em] text-[var(--brand-muted)]">Concept image · final boards approved by each venue</p></div>
      </div>
    </section>

    <section id="join" class="bg-[var(--brand-ink)] py-12 text-[var(--brand-paper)] md:py-16"><div class="site-shell"><p class="cb-kicker">Two ways to join</p><div class="mt-6 grid gap-4 lg:grid-cols-2"><article class="border-2 border-white/45 p-6 md:p-8"><p class="text-[.62rem] font-bold uppercase tracking-[.1em] text-[var(--brand-yellow)]">I run a venue</p><h2 class="mt-4 font-editorial text-5xl uppercase">Get a free board.</h2><p class="mt-4 max-w-xl text-sm leading-6 text-white/65">You get a reusable 24×36 board for specials, events, and announcements. You approve the design and featured businesses. You pay $0.</p><a class="brand-button mt-7" href="#interest-form">I want to host one →</a></article><article class="border-2 border-white/45 p-6 md:p-8"><p class="text-[.62rem] font-bold uppercase tracking-[.1em] text-[var(--brand-yellow)]">I run a local business</p><h2 class="mt-4 font-editorial text-5xl uppercase">Get 90 days free.</h2><p class="mt-4 max-w-xl text-sm leading-6 text-white/65">Your name appears inside a trusted local venue, while the shared QR page carries your contact details and tracks activity. Review the results after 90 days, then continue only if you want to.</p><a class="brand-button mt-7" href="#interest-form">Claim a free spot →</a></article></div></div></section>

    <section class="cb-paper py-20 md:py-28"><div class="site-shell grid items-center gap-14 lg:grid-cols-[.7fr_1.3fr]"><div class="mx-auto w-full max-w-sm px-5"><BoardVisual venue="YOUR LOGO HERE" label="HAND-LETTERED FOR" /></div><div><p class="site-eyebrow">A community idea you can see</p><h2 class="cb-heading">Less algorithm.<br/><span class="cb-pink-line">More neighborhood.</span></h2><p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--brand-muted)]">I spend a lot of time around AI. This project is intentionally tangible: useful signage for the venue, paid creative opportunities for local artists, and a warm introduction for nearby businesses.</p><div class="mt-9 grid gap-4 sm:grid-cols-2">{[['Venue first','Most of the board stays available for useful daily writing. Venue sponsor referrals are welcomed—we want businesses you already trust, recommend, or simply love.'],['Drawn by a local artist','The entire board—including your logo—is hand-drawn in liquid chalk by a local artist, making it personal, flexible, and reusable.'],['Built to be shared','Venues, artists, and partners can photograph and share the finished board with their audiences.'],['Six local partners','The board stays clean: six names in chalk, while the QR page carries their websites and contact details.']].map(([title,copy]) => <article class="border-t-2 border-[var(--brand-ink)] pt-4"><h3 class="text-sm font-bold uppercase">{title}</h3><p class="mt-3 text-sm leading-6 text-[var(--brand-muted)]">{copy}</p></article>)}</div></div></div></section>

    <section class="border-y-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] py-20 md:py-24"><div class="site-shell"><div class="grid items-end gap-8 lg:grid-cols-[1fr_.75fr]"><div><p class="site-eyebrow !text-[var(--brand-ink)]">The complete partner offer</p><h2 class="cb-heading">Try it free.<br/>See the proof.<br/><span class="cb-pink-line">Then decide.</span></h2></div><div><p class="text-lg leading-8">Your founding placement is free for 90 days. At the end, I share the activity. Renew as a paid partner only if the relationship earned the right to continue.</p><p class="mt-5 text-[.62rem] font-black uppercase tracking-[.09em]">No paid contract during the pilot · No automatic renewal · No pressure</p></div></div><div class="mt-12 grid gap-4 md:grid-cols-3">{[['01','Choose a local board','Match your customers with the right venue and neighborhood.'],['02','Get 90 days free','Your business name is hand-lettered onto the board; your details live behind the shared QR.'],['03','Review the activity','See scans, partner taps, and venue actions before deciding what comes next.']].map(([n,title,copy]) => <article class="border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] p-6 shadow-[6px_6px_0_var(--brand-ink)]"><span class="font-editorial text-5xl text-[var(--brand-orange)]">{n}</span><h3 class="mt-9 font-editorial text-4xl uppercase">{title}</h3><p class="mt-4 text-sm leading-6 text-[var(--brand-muted)]">{copy}</p></article>)}</div></div></section>

    <section id="examples" class="cb-paper py-20 md:py-28"><div class="site-shell"><div class="grid items-end gap-8 lg:grid-cols-[1fr_.7fr]"><div><p class="site-eyebrow">What it could look like</p><h2 class="cb-heading">Same format.<br/><span class="cb-yellow-line">Made for the place.</span></h2></div><p class="max-w-xl text-sm leading-6 text-[var(--brand-muted)]">Every concept uses the same 24×36 size, compact footer, and QR system. Venue identity and local hand-lettering make each one feel at home.</p></div><div class="mt-12 grid gap-7 sm:grid-cols-2">{examples.map((example,index) => <figure class:list={["border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] shadow-[7px_7px_0_var(--brand-ink)]", index % 2 === 1 && "sm:translate-y-7"]}><Image src={example.image} alt={`${example.name} community board concept`} class="aspect-[2/3] w-full bg-[var(--brand-ink)] object-contain" widths={[520,760,1000]} sizes="(min-width:640px) 48vw, 100vw" loading="lazy"/><figcaption class="border-t-2 border-[var(--brand-ink)] p-4"><p class="font-editorial text-3xl uppercase">{example.name}</p><div class="mt-2 flex items-center justify-between gap-3 text-[.56rem] font-bold uppercase tracking-[.08em] text-[var(--brand-muted)]"><span>{example.type}</span><span>24 × 36 concept</span></div></figcaption></figure>)}</div><p class="mt-14 max-w-3xl text-xs leading-5 text-[var(--brand-muted)]">Speculative concepts only; no current partnership or approval is implied.</p></div></section>

    <section class="border-y-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] py-20 md:py-28"><div class="site-shell grid items-center gap-12 lg:grid-cols-[.82fr_1.18fr]"><div><p class="site-eyebrow">Demo metrics dashboard</p><h2 class="cb-heading">Eyeballs in person.<br/><span class="cb-pink-line">Reach on social.</span></h2><p class="mt-7 max-w-xl text-base leading-7 text-[var(--brand-muted)]">We separate the numbers clearly: estimated foot traffic shows in-venue opportunity, tagged posts show reported social reach, and the unique QR directly tracks visits and actions.</p><div class="mt-8 grid grid-cols-2 gap-3">{[['2,400','Est. monthly venue visits'],['8','Reported board shares'],['3,100','Reported social reach'],['127','Tracked QR visits']].map(([value,label]) => <div class="border-2 border-[var(--brand-ink)] bg-white p-4 shadow-[4px_4px_0_var(--brand-ink)]"><b class="font-editorial text-5xl leading-none">{value}</b><p class="mt-2 text-[.55rem] font-bold uppercase tracking-[.06em] text-[var(--brand-muted)]">{label}</p></div>)}</div><p class="mt-5 text-[.58rem] font-bold uppercase tracking-[.08em] text-[var(--brand-muted)]">Illustrative demo · foot traffic is estimated · social reach is reported · QR activity is measured directly</p></div><div class="border-2 border-[var(--brand-ink)] bg-white p-6 shadow-[9px_9px_0_var(--brand-ink)]"><div class="flex items-center justify-between gap-5 border-b-2 border-[var(--brand-ink)] pb-5"><div><p class="text-[.58rem] font-bold uppercase tracking-[.1em] text-[var(--brand-orange)]">The page behind the QR</p><p class="mt-2 font-editorial text-4xl uppercase">Your neighborhood board</p></div><div class="cb-real-qr grid h-20 w-20 shrink-0 place-items-center border-[5px] border-white bg-white text-[.48rem] font-black">QR</div></div><div class="mt-5 grid gap-3 sm:grid-cols-2"><article class="border-2 border-[var(--brand-ink)] bg-[var(--brand-bg)] p-4"><p class="text-[.54rem] font-bold uppercase text-[var(--brand-orange)]">Featured venue</p><h3 class="mt-2 font-editorial text-3xl uppercase">Specials, directions & links</h3></article><article class="border-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] p-4"><p class="text-[.54rem] font-bold uppercase">Local artist credit</p><h3 class="mt-2 font-editorial text-3xl uppercase">Meet the hand behind it</h3></article></div><div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">{['Brier Creek Realty','Design Mechanical','Vent & Duct','Legacy Plumbing','Martin Lawn','Layton & Carraway'].map(name => <div class="border border-[var(--brand-ink)] p-3 text-center text-[.56rem] font-bold uppercase">{name}</div>)}</div><a class="brand-button mt-5 w-full" href="/community-boards/location/sample-board/">Open the QR-page demo →</a></div></div></section>

    <section class="cb-paper py-20 md:py-24"><div class="site-shell grid gap-12 lg:grid-cols-[.55fr_1fr]"><div><p class="site-eyebrow">Quick answers</p><h2 class="cb-heading">Nothing hidden.</h2></div><div class="grid gap-3">{faqs.map(([q,a],i) => <details class="group border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] px-5" open={i===0}><summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3 font-bold"><span>{q}</span><span class="text-2xl text-[var(--brand-orange)] group-open:rotate-45">+</span></summary><p class="pb-5 text-sm leading-6 text-[var(--brand-muted)]">{a}</p></details>)}</div></div></section>

    <section id="interest-form" class="border-t-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] py-20 md:py-28"><div class="site-shell grid gap-12 lg:grid-cols-[.72fr_1fr] lg:items-start"><div><p class="site-eyebrow !text-[var(--brand-ink)]">One short form</p><h2 class="cb-heading">Interested?<br/><span class="cb-pink-line">That’s enough.</span></h2><p class="mt-7 max-w-lg text-base leading-7">Tell me which side of the board you’re on. No meeting is required just to raise your hand.</p></div><form name="community-board-interest" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="website-check" class="grid gap-5 border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] p-6 shadow-[8px_8px_0_var(--brand-ink)] sm:p-8"><input type="hidden" name="form-name" value="community-board-interest"/><p class="hidden"><label>Leave this empty: <input name="website-check"/></label></p><h3 class="font-editorial text-5xl uppercase">Raise your hand.</h3><label class="intake-label">I’m interested in *<select class="intake-field" required name="interest-type"><option value="">Choose one…</option><option>Getting 90 days free on a board</option><option>Hosting a free board at my venue</option><option>Lettering boards as a local artist</option><option>Learning more</option></select></label><div class="grid gap-4 sm:grid-cols-2"><label class="intake-label">Business name *<input class="intake-field" required name="business-name" autocomplete="organization"/></label><label class="intake-label">Your name *<input class="intake-field" required name="contact-name" autocomplete="name"/></label><label class="intake-label">Email *<input class="intake-field" required type="email" name="email" autocomplete="email"/></label><label class="intake-label">Phone<input class="intake-field" type="tel" name="phone" autocomplete="tel"/></label></div><label class="intake-label">Website or social profile<input class="intake-field" name="business-link" placeholder="Website, Instagram, or Facebook"/></label><label class="intake-label">Anything I should know?<textarea class="intake-field min-h-24" name="notes" placeholder="Neighborhood, audience, venue, or a quick question…"></textarea></label><button class="brand-button w-full sm:w-fit" type="submit">I’m interested →</button><p class="text-[.62rem] leading-5 text-[var(--brand-muted)]">This form creates no agreement. The 90-day partner pilot has no automatic renewal or billing.</p></form></div></section>
  </div>
</BaseLayout>

<style is:global>
  .community-boards .cb-paper { background-color:var(--brand-bg); background-image:radial-gradient(rgb(23 19 15 / 8%) .7px,transparent .8px); background-size:8px 8px; }
  .community-boards .cb-heading { margin-top:1rem; font-size:clamp(4.3rem,8.5vw,7rem); line-height:.82; }
  .community-boards .cb-yellow-line { text-decoration:underline; text-decoration-color:var(--brand-yellow); text-decoration-thickness:.09em; text-underline-offset:.04em; }
  .community-boards .cb-pink-line { text-decoration:underline; text-decoration-color:var(--brand-orange); text-decoration-thickness:.08em; text-underline-offset:.04em; }
  .community-boards .cb-kicker { color:var(--brand-yellow); font-size:.62rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .community-boards .cb-button-light { display:inline-flex; min-height:2.75rem; align-items:center; justify-content:center; border:2px solid var(--brand-ink); padding-inline:1rem; color:var(--brand-ink); background:var(--brand-surface); box-shadow:4px 4px 0 var(--brand-ink); font-size:.78rem; font-weight:800; text-transform:uppercase; transition:140ms; }
  .community-boards .cb-button-light:hover { transform:translate(2px,2px); box-shadow:2px 2px 0 var(--brand-ink); }
  .community-boards .cb-real-qr { background-image:repeating-conic-gradient(var(--brand-ink) 0 25%,white 0 50%); background-size:9px 9px; text-shadow:0 0 3px white,0 0 5px white; }
  .community-boards details summary::-webkit-details-marker { display:none; }
</style>
