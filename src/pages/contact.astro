---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const email = "danny@raleighaiguy.com";
const emailHref = `mailto:${email}?subject=${encodeURIComponent("Let’s talk about my business")}`;
---

<BaseLayout
  pageTitle="Contact Danny Sullivan — Raleigh AI Guy"
  pageDescription="Tell Danny Sullivan about your business and what you’d like to make easier. Start a conversation by email."
>
  <section>
    <Wrapper variant="wide" class="py-14 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-3xl">
        <p class="print-stamp">You’re in the right place</p>
        <h1 class="font-editorial mt-6 text-6xl font-medium leading-[1.02] tracking-[-.025em] sm:text-8xl">Let’s make the work easier.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-base-600">Tell me a little about your business and what’s taking too much time. A few sentences is plenty. I’ll read your email and reply personally.</p>

        <div class="print-panel mt-10 p-6 sm:p-9">
          <h2 class="text-3xl">Start with an email.</h2>
          <p class="mt-3 text-base leading-7 text-base-600">What do you do, and what would you like to make easier? You don’t need to know which tool or service you need.</p>
          <a href={emailHref} class="site-cta mt-7">Email Danny →</a>
          <p class="contact-address mt-5 font-bold">{email}</p>
          <p class="mt-2 text-sm leading-6 text-base-600">The button opens your email app. You can also copy the address into the email service you use.</p>
        </div>

        <div class="mt-10 max-w-2xl">
          <h2 class="text-3xl">What happens next?</h2>
          <p class="mt-3 text-base leading-7 text-base-600">I’ll ask any questions I need to understand the problem, then suggest a useful next step. If it makes sense to work together, we’ll agree on the scope and cost before any work begins.</p>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<style>
  .contact-address { overflow-wrap: anywhere; }
</style>
