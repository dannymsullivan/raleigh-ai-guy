---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { communityBoardProspects, type CommunityBoardProspect } from '@/data/communityBoardProspects';

export function getStaticPaths() {
  return communityBoardProspects.map((prospect) => ({ params: { slug: prospect.slug }, props: { prospect } }));
}

interface Props { prospect: CommunityBoardProspect }
const { prospect } = Astro.props;
---

<BaseLayout pageTitle={`${prospect.name} Community Board Concept`} pageDescription={`A private custom community board concept prepared for ${prospect.name}.`} socialImage={prospect.image.src} socialImageAlt={`${prospect.name} custom specials board concept`} noindex={true}>
  <div class="pitch-page">
    <section class="pitch-paper border-b-2 border-[var(--brand-ink)] py-12 md:py-20"><div class="site-shell grid items-center gap-12 lg:grid-cols-[.85fr_1.15fr]">
      <div><span class="print-stamp">A private concept prepared for {prospect.name}</span><p class="mt-8 text-xs font-bold uppercase tracking-[.12em]">{prospect.area} · {prospect.venueType}</p><h1 class="mt-4 text-[clamp(4.8rem,10vw,8.5rem)] leading-[.8]">I made this<br/><span class="pitch-yellow-line">for you.</span></h1><p class="mt-8 max-w-xl text-lg leading-8 text-[var(--brand-muted)]">A useful, professionally designed specials board for <strong class="text-[var(--brand-ink)]">{prospect.name}</strong>—designed, produced, and installed for <strong class="text-[var(--brand-ink)]">$0.</strong></p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="brand-button" href="#claim-board">I’m interested →</a><a class="pitch-button-light" href="/community-boards/">See how it works</a></div><p class="mt-7 text-[.62rem] font-bold uppercase tracking-[.06em] text-[var(--brand-muted)]">Concept only · no partnership or approval implied</p></div>
      <figure class="mx-auto w-full max-w-2xl"><Image src={prospect.image} alt={`${prospect.name} community board pitch concept`} class="aspect-[2/3] w-full border-2 border-[var(--brand-ink)] object-cover shadow-[9px_9px_0_var(--brand-ink)]" widths={[560,820,1100]} sizes="(min-width:1024px) 52vw, 100vw" loading="eager"/><figcaption class="mt-4 text-right text-[.58rem] font-bold uppercase tracking-[.08em] text-[var(--brand-muted)]">Pitch concept · final design subject to venue approval</figcaption></figure>
    </div></section>

    <section class="bg-[var(--brand-ink)] py-18 text-[var(--brand-paper)] md:py-24"><div class="site-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
      <div><p class="pitch-kicker">Why it fits</p><h2 class="mt-4 font-editorial text-[clamp(4rem,8vw,7rem)] leading-[.82] uppercase">Useful first.<br/><span class="pitch-yellow-line">Free to you.</span></h2></div>
      <div><p class="max-w-2xl text-lg leading-8 text-white/75">{prospect.fit}</p><div class="mt-10 grid gap-4 sm:grid-cols-3">{prospect.uses.map((use, index) => <article class="border-t-2 border-white/25 pt-5"><span class="font-editorial text-4xl text-[var(--brand-orange)]">0{index + 1}</span><p class="mt-6 text-sm font-bold uppercase leading-5">{use}</p></article>)}</div></div>
    </div></section>

    <section class="pitch-paper py-18 md:py-24"><div class="site-shell"><div class="max-w-3xl"><p class="site-eyebrow">The arrangement</p><h2 class="mt-4 font-editorial text-[clamp(4rem,8vw,7rem)] leading-[.82] uppercase">Your board.<br/>Local businesses fund it.</h2><p class="mt-7 max-w-2xl leading-7 text-[var(--brand-muted)]">You approve the concept and sponsor categories. I coordinate the design, sponsor placements, production, and installation. The writing area remains yours to update.</p><aside class="mt-7 border-l-4 border-[var(--brand-orange)] pl-5"><p class="text-xs font-bold uppercase tracking-[.08em]">Optional tracked QR</p><p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--brand-muted)]">Once the venue and sponsors are confirmed, the finished board can include one discreet QR code linking to a location-specific sponsor page. Board scans and individual sponsor clicks can then be measured separately. It is intentionally omitted from this concept image until a real destination exists.</p></aside></div><div class="mt-12 grid gap-4 md:grid-cols-3">{[['01','Approve the idea','Confirm the placement, size, and sponsor categories.'],['02','I handle the build','I finalize sponsors, design the board, and coordinate production.'],['03','We install it','Your team gets a polished reusable board without a purchase cost.']].map(([n,title,copy]) => <article class="print-panel p-6"><span class="font-editorial text-5xl text-[var(--brand-orange)]">{n}</span><h3 class="mt-12 font-editorial text-4xl uppercase">{title}</h3><p class="mt-4 text-sm leading-6 text-[var(--brand-muted)]">{copy}</p></article>)}</div></div></section>

    <section id="claim-board" class="border-t-2 border-[var(--brand-ink)] bg-[var(--brand-yellow)] py-18 md:py-24"><div class="site-shell grid gap-12 lg:grid-cols-[.75fr_1fr]">
      <div><p class="site-eyebrow !text-[var(--brand-ink)]">No obligation</p><h2 class="mt-4 font-editorial text-[clamp(4rem,8vw,7rem)] leading-[.82] uppercase">Want this<br/>for {prospect.name}?</h2><p class="mt-7 max-w-lg text-sm leading-6">Send a quick note. This only starts a conversation—it does not commit you to hosting a board.</p></div>
      <form name="community-board-pitch-response" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="website-check" class="grid gap-5 border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] p-6 shadow-[7px_7px_0_var(--brand-ink)] sm:p-8"><input type="hidden" name="form-name" value="community-board-pitch-response"/><input type="hidden" name="prospect" value={prospect.name}/><input type="hidden" name="prospect-slug" value={prospect.slug}/><p class="hidden"><label>Leave this empty: <input name="website-check"/></label></p><h3 class="font-editorial text-5xl uppercase">Let’s talk about the board.</h3><div class="grid gap-4 sm:grid-cols-2"><label class="intake-label">Your name *<input class="intake-field" required name="contact-name" autocomplete="name"/></label><label class="intake-label">Email *<input class="intake-field" required type="email" name="email" autocomplete="email"/></label></div><label class="intake-label">Phone<input class="intake-field" type="tel" name="phone" autocomplete="tel"/></label><label class="intake-label">Questions or notes<textarea class="intake-field min-h-28" name="notes" placeholder="Placement ideas, sponsor questions, timing…"></textarea></label><button class="brand-button w-full sm:w-fit" type="submit">I’m interested <span aria-hidden="true">→</span></button><p class="text-[.62rem] leading-5 text-[var(--brand-muted)]">This private page is a speculative pitch concept. {prospect.name} is not represented as a current participant.</p></form>
    </div></section>
  </div>
</BaseLayout>

<style is:global>
  .pitch-page .pitch-paper { background-color:var(--brand-bg); background-image:radial-gradient(rgb(23 19 15 / 8%) .7px,transparent .8px); background-size:8px 8px; }
  .pitch-page .pitch-yellow-line { text-decoration:underline; text-decoration-color:var(--brand-yellow); text-decoration-thickness:.09em; text-underline-offset:.04em; }
  .pitch-page .pitch-kicker { color:var(--brand-yellow); font-size:.62rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .pitch-page .pitch-button-light { display:inline-flex; min-height:2.75rem; align-items:center; justify-content:center; border:2px solid var(--brand-ink); padding-inline:1rem; color:var(--brand-ink); background:var(--brand-surface); box-shadow:4px 4px 0 var(--brand-ink); font-size:.78rem; font-weight:800; text-transform:uppercase; }
</style>
