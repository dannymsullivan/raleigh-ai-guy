---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { communityBoardLocations, type CommunityBoardLocation } from '@/data/communityBoardLocations';

export function getStaticPaths() {
  return communityBoardLocations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

interface Props { location: CommunityBoardLocation }
const { location } = Astro.props;
const isDemo = location.status === 'demo';
---

<BaseLayout
  pageTitle={`${location.venueName} | Raleigh Community Boards`}
  pageDescription={location.description}
  socialImage={location.image.src}
  socialImageAlt={`${location.venueName} community board`}
  noindex={isDemo}
>
  <div class="scan-page">
    {isDemo && <div class="scan-demo-bar"><span>Interactive scan-page demo · offers are illustrative</span><a href={`/community-boards/dashboard/${location.slug}/`}>See the results dashboard →</a></div>}

    <header class="scan-hero">
      <div class="scan-shell grid items-center gap-9 py-10 md:grid-cols-[.72fr_1.28fr] md:py-16">
        <Image src={location.image} alt={`${location.venueName} community board installed inside a restaurant`} class="mx-auto aspect-[2/3] w-full max-w-sm border-2 border-[var(--scan-ink)] object-cover shadow-[8px_8px_0_var(--scan-ink)]" widths={[420,640,820]} sizes="(min-width:768px) 36vw, 90vw" loading="eager" />
        <div>
          <p class="scan-kicker">You found a Raleigh Community Board</p>
          <h1 class="mt-4 font-editorial text-[clamp(4.6rem,11vw,8.5rem)] leading-[.76] uppercase">Local deals.<br/><span>Real neighbors.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-[var(--scan-muted)]">Discover the venue, meet the six businesses supporting this board, and tap into a useful local offer.</p>
          <div class="mt-8 border-l-4 border-[var(--scan-pink)] pl-5">
            <p class="text-[.58rem] font-black uppercase tracking-[.12em] text-[var(--scan-muted)]">Featured venue</p>
            <h2 class="mt-2 font-editorial text-4xl uppercase">{location.venueName}</h2>
            <p class="mt-2 text-sm text-[var(--scan-muted)]">{location.area} · {location.venueType}</p>
          </div>
          <div class="mt-7 flex flex-wrap gap-3">
            {location.venueWebsite && <a class="scan-button" href={location.venueWebsite} rel="noreferrer">Visit the venue →</a>}
            {location.directionsUrl && <a class="scan-button scan-button-light" href={location.directionsUrl} rel="noreferrer">Get directions</a>}
            <a class="scan-button scan-button-light" href="#local-deals">See the deals ↓</a>
          </div>
        </div>
      </div>
    </header>

    <main id="local-deals" class="scan-deals py-16 md:py-24">
      <div class="scan-shell">
        <div class="grid items-end gap-6 border-b-2 border-[var(--scan-ink)] pb-8 md:grid-cols-[1fr_.72fr]">
          <div><p class="scan-kicker">Six businesses · six reasons to tap</p><h2 class="mt-4 font-editorial text-[clamp(4rem,9vw,7rem)] leading-[.8] uppercase">Today’s local offers.</h2></div>
          <p class="max-w-lg text-sm leading-6 text-[var(--scan-muted)]">Each business controls its own offer and CTA. Every tap can be measured, so partners can see what the board actually produces.</p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {location.partners.map((partner, index) => (
            <article class={`deal-card deal-card-${index + 1}`}>
              <div class="deal-card-top">
                <p class="deal-category">{partner.category}</p>
                <span>0{index + 1}</span>
              </div>
              <div class="deal-card-body">
                <p class="deal-eyebrow">{partner.offer.eyebrow}</p>
                <h3>{partner.offer.title}</h3>
                <p class="deal-description">{partner.offer.description}</p>
                {partner.offer.code && <div class="deal-code"><span>Demo code</span><strong>{partner.offer.code}</strong></div>}
              </div>
              <div class="deal-card-footer">
                <div><p>{partner.name}</p><small>{partner.website}</small></div>
                <button type="button" data-demo-cta data-partner={partner.name} data-label={partner.offer.ctaLabel} data-href={partner.href ?? '#'}>{partner.offer.ctaLabel} →</button>
              </div>
            </article>
          ))}
        </div>
        {isDemo && <p class="mt-8 text-[.58rem] font-bold uppercase tracking-[.09em] text-[var(--scan-muted)]">Illustrative demo offers only · no promotion or partnership is represented as approved</p>}
      </div>
    </main>

    <section class="scan-artist py-14 md:py-18">
      <div class="scan-shell grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div><p class="scan-kicker !text-[var(--scan-yellow)]">Made by hand in Raleigh</p><h2 class="mt-3 font-editorial text-5xl uppercase md:text-6xl">Lettering by {location.artist.name}</h2><p class="mt-4 max-w-2xl text-sm leading-6">The entire board—including the venue logo—is hand-drawn by a local chalk artist. The digital page tracks the response; the physical board stays human.</p></div>
        {location.artist.href && <a class="scan-button scan-button-light" href={location.artist.href} rel="noreferrer">Meet the artist →</a>}
      </div>
    </section>

    <section class="border-t-2 border-[var(--scan-ink)] bg-[var(--scan-yellow)] py-16 text-center md:py-22">
      <div class="scan-shell"><p class="scan-kicker !text-[var(--scan-ink)]">Want your business here?</p><h2 class="mx-auto mt-4 max-w-4xl font-editorial text-[clamp(4rem,9vw,7rem)] leading-[.8] uppercase">Try a local spot free for 90 days.</h2><a class="scan-button mt-8" href="/community-boards/#interest-form">Raise your hand →</a></div>
    </section>

    <dialog class="deal-dialog" data-deal-dialog>
      <button class="deal-dialog-close" type="button" data-close-dialog aria-label="Close">×</button>
      <p class="scan-kicker">Demo CTA recorded</p>
      <h2 class="mt-4 font-editorial text-5xl leading-[.85] uppercase" data-dialog-partner>Local partner</h2>
      <p class="mt-5 text-sm leading-6 text-[var(--scan-muted)]">On a live board, this click is attributed to the venue, board, offer, and partner before the guest continues.</p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row"><a class="scan-button" data-dialog-link href="#">Continue to business →</a><button class="scan-button scan-button-light" type="button" data-close-dialog>Stay on demo</button></div>
    </dialog>
  </div>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-deal-dialog]');
  const partnerName = dialog?.querySelector<HTMLElement>('[data-dialog-partner]');
  const partnerLink = dialog?.querySelector<HTMLAnchorElement>('[data-dialog-link]');

  document.querySelectorAll<HTMLButtonElement>('[data-demo-cta]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog) return;
      if (partnerName) partnerName.textContent = button.dataset.partner ?? 'Local partner';
      if (partnerLink) partnerLink.href = button.dataset.href ?? '#';
      dialog.showModal();
    });
  });
  dialog?.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => button.addEventListener('click', () => dialog.close()));
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>

<style is:global>
  .scan-page { --scan-ink:#17130f; --scan-paper:#f7f1df; --scan-yellow:#f0df55; --scan-pink:#f43e8d; --scan-orange:#f15a32; --scan-muted:#6d6257; color:var(--scan-ink); background:var(--scan-paper); }
  .scan-shell { width:min(100% - 2rem,72rem); margin-inline:auto; }
  .scan-demo-bar { display:flex; flex-wrap:wrap; justify-content:center; gap:.5rem 1.25rem; border-bottom:2px solid var(--scan-ink); padding:.7rem 1rem; color:var(--scan-ink); background:var(--scan-yellow); font-size:.6rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .scan-demo-bar a { text-decoration:underline; text-underline-offset:3px; }
  .scan-hero,.scan-deals { background-image:radial-gradient(rgb(23 19 15 / 8%) .7px,transparent .8px); background-size:8px 8px; }
  .scan-kicker { color:var(--scan-orange); font-size:.62rem; font-weight:900; letter-spacing:.11em; text-transform:uppercase; }
  .scan-hero h1 span { text-decoration:underline; text-decoration-color:var(--scan-yellow); text-decoration-thickness:.09em; text-underline-offset:.03em; }
  .scan-button { display:inline-flex; min-height:2.85rem; align-items:center; justify-content:center; border:2px solid var(--scan-ink); padding:.65rem .9rem; color:var(--scan-paper); background:var(--scan-ink); box-shadow:4px 4px 0 var(--scan-pink); font-size:.68rem; font-weight:900; text-transform:uppercase; transition:transform 150ms ease,box-shadow 150ms ease; }
  .scan-button:hover { transform:translate(2px,2px); box-shadow:2px 2px 0 var(--scan-pink); }
  .scan-button-light { color:var(--scan-ink); background:var(--scan-paper); box-shadow:4px 4px 0 var(--scan-ink); }
  .scan-deals { border-top:2px solid var(--scan-ink); }
  .deal-card { display:flex; min-height:27rem; flex-direction:column; overflow:hidden; border:2px solid var(--scan-ink); background:#fffdf6; box-shadow:7px 7px 0 var(--scan-ink); }
  .deal-card-top { display:flex; align-items:center; justify-content:space-between; border-bottom:2px solid var(--scan-ink); padding:.8rem 1rem; background:var(--deal-accent,var(--scan-yellow)); }
  .deal-card-top span { font-family:"Bebas Neue",sans-serif; font-size:2.2rem; line-height:1; }
  .deal-category,.deal-eyebrow { font-size:.58rem; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
  .deal-card-body { padding:1.5rem; }
  .deal-eyebrow { color:var(--scan-orange); }
  .deal-card h3 { margin-top:.75rem; max-width:28rem; font-family:"Bebas Neue",sans-serif; font-size:clamp(2.8rem,7vw,4.5rem); line-height:.86; text-transform:uppercase; }
  .deal-description { margin-top:1.2rem; max-width:33rem; color:var(--scan-muted); font-size:.9rem; line-height:1.65; }
  .deal-code { display:inline-flex; margin-top:1.25rem; align-items:center; gap:.65rem; border:1px dashed var(--scan-ink); padding:.55rem .7rem; }
  .deal-code span { color:var(--scan-muted); font-size:.52rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .deal-code strong { font-size:.78rem; letter-spacing:.08em; }
  .deal-card-footer { display:flex; margin-top:auto; flex-direction:column; gap:1rem; border-top:2px solid var(--scan-ink); padding:1rem 1.5rem; background:var(--scan-ink); color:var(--scan-paper); }
  .deal-card-footer p { font-family:"Bebas Neue",sans-serif; font-size:1.7rem; line-height:1; text-transform:uppercase; }
  .deal-card-footer small { display:block; margin-top:.35rem; color:#fff9; font-size:.58rem; font-weight:700; }
  .deal-card-footer button { min-height:2.75rem; border:2px solid var(--scan-paper); padding:.6rem .8rem; color:var(--scan-ink); background:var(--deal-accent,var(--scan-yellow)); font-size:.62rem; font-weight:900; text-transform:uppercase; }
  .deal-card-1 { --deal-accent:#f0df55; }.deal-card-2 { --deal-accent:#f43e8d; }.deal-card-3 { --deal-accent:#8fcfd1; }.deal-card-4 { --deal-accent:#f3a65a; }.deal-card-5 { --deal-accent:#a9d26f; }.deal-card-6 { --deal-accent:#c1a7e2; }
  .scan-artist { border-top:2px solid var(--scan-ink); color:var(--scan-paper); background:var(--scan-ink); }
  .deal-dialog { width:min(100% - 2rem,34rem); border:2px solid var(--scan-ink); padding:2rem; color:var(--scan-ink); background:var(--scan-paper); box-shadow:9px 9px 0 var(--scan-pink); }
  .deal-dialog::backdrop { background:rgb(23 19 15 / 75%); backdrop-filter:blur(3px); }
  .deal-dialog-close { position:absolute; top:.6rem; right:.8rem; font-family:"Bebas Neue",sans-serif; font-size:2rem; }
  @media (min-width:640px) { .deal-card-footer { flex-direction:row; align-items:center; justify-content:space-between; }.deal-card-footer button { max-width:14rem; } }
</style>
