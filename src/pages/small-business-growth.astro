---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const deliverables = [
  ["A website people understand", "Up to five focused pages that explain the offer, build trust, and give visitors a clear next step."],
  ["A credible Google presence", "A Google Business Profile audit and cleanup so the business information, services, and presentation agree with the site."],
  ["A search-ready foundation", "Technical and local SEO essentials, metadata, sitemap, and launch checks—without pretending a one-time project guarantees rankings."],
  ["Measurement that answers something", "Google Analytics, Search Console, and conversion events for calls or forms so you can see what is creating opportunities."],
];
---

<BaseLayout pageTitle="Local Presence Sprint — Raleigh AI Guy" pageDescription="A focused $2,500 local-presence sprint for established Raleigh service businesses: website, Google Business Profile, local SEO foundations, analytics, and conversion tracking.">
  <section class="border-b-[3px] border-black bg-[var(--brand-yellow)]">
    <Wrapper variant="wide" class="py-14 sm:py-20 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="print-stamp bg-[var(--brand-paper)]">The easiest way in</p>
          <h1 class="font-editorial mt-6 max-w-5xl text-6xl leading-[.86] sm:text-8xl lg:text-[7.5rem]">Make the business look as established as it really is.</h1>
        </div>
        <div class="border-l-2 border-black pl-5 lg:col-span-4">
          <p class="field-label">Local Presence Sprint</p>
          <p class="font-editorial mt-3 text-6xl leading-none">$2,500</p>
          <p class="field-label mt-2">one-time · from</p>
          <p class="mt-6 text-base leading-7 text-black/65">A focused website, Google presence, local-search foundation, and measurement setup—connected as one useful system.</p>
          <a class="site-cta mt-7" href="/contact/?service=local-presence">Ask about the sprint →</a>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="mb-10 grid gap-6 lg:grid-cols-12">
        <p class="field-label lg:col-span-3">What changes</p>
        <div class="lg:col-span-7"><h2 class="font-editorial text-5xl leading-[.9] sm:text-6xl">Four outcomes. Not a giant checklist.</h2><p class="mt-5 max-w-2xl text-sm leading-6 text-base-600">The exact tools can vary. The point is to leave with a presence customers can trust and a baseline you can measure.</p></div>
      </div>
      <div class="grid border-l-2 border-t-2 border-black sm:grid-cols-2">
        {deliverables.map(([title, body], index) => (
          <article class:list={["min-h-64 border-b-2 border-r-2 border-black p-6 sm:p-8", index === 1 && "bg-[var(--brand-orange)]", index === 2 && "bg-[var(--brand-yellow)]"]}>
            <span class="field-label">0{index + 1}</span>
            <h3 class="font-editorial mt-8 text-4xl leading-none">{title}</h3>
            <p class="mt-4 max-w-xl text-sm leading-6 text-black/65">{body}</p>
          </article>
        ))}
      </div>
    </Wrapper>
  </section>

  <section class="border-y-[3px] border-black bg-[var(--brand-ink)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="grid gap-12 py-16 sm:py-24 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="field-label text-white/45">A real example</p>
        <h2 class="font-editorial mt-5 text-5xl leading-[.9] sm:text-6xl">A local foundation can become a useful growth system.</h2>
        <p class="mt-6 text-sm leading-6 text-white/65">For Garden & Art Landscapes, the work connected a new website to a human-reviewed SEO publishing system and a dashboard the owner can actually inspect.</p>
        <a class="mt-7 inline-flex min-h-12 items-center border-2 border-white bg-[var(--brand-orange)] px-4 text-xs font-black uppercase text-black shadow-[4px_4px_0_#fff]" href="/projects/garden-art-landscapes/">See the case study →</a>
      </div>
      <a class="block border-2 border-white bg-white p-2 shadow-[8px_8px_0_var(--brand-orange)] lg:col-span-7" href="/projects/garden-art-landscapes/" aria-label="View the Garden and Art Landscapes SEO case study">
        <img src="/case-study/landscaping-seo/01-dashboard-overview.png" alt="Landscaping Raleigh SEO dashboard showing aggregate website and search activity." width="1440" height="1000" loading="lazy" decoding="async" />
      </a>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-orange)]">
    <Wrapper variant="wide" class="py-16 sm:py-20">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4"><p class="print-stamp bg-[var(--brand-yellow)]">A clean boundary</p><h2 class="font-editorial mt-5 text-5xl leading-[.9]">The sprint does not hide a compulsory retainer.</h2></div>
        <div class="grid gap-px bg-black lg:col-span-8 sm:grid-cols-2">
          <article class="bg-[var(--brand-paper)] p-7"><p class="field-label">Stop here</p><h3 class="font-editorial mt-7 text-4xl leading-none">Own the foundation.</h3><p class="mt-4 text-sm leading-6 text-base-600">If the sprint solves the immediate problem, you keep the site, accounts, analytics, and documentation. Hosting, paid tools, and unusual migrations are approved separately.</p></article>
          <article class="bg-[var(--brand-yellow)] p-7"><p class="field-label">Keep going</p><h3 class="font-editorial mt-7 text-4xl leading-none">Move into consulting.</h3><p class="mt-4 text-sm leading-6 text-black/65">If there is a real backlog of growth and operational priorities, the next step is the $2,500/month consulting partnership—not a collection of disconnected mini-retainers.</p><a class="mt-7 inline-flex text-xs font-black uppercase underline underline-offset-4" href="/services/#consulting">See ongoing consulting →</a></article>
        </div>
      </div>
      <p class="mt-6 max-w-3xl text-xs leading-5 text-black/60">The starting scope assumes an established service business, existing brand assets, client-provided photography, and timely approvals. Original identity work, extensive copywriting, ecommerce, paid advertising, multi-location SEO, and larger custom features are quoted separately.</p>
    </Wrapper>
  </section>

  <ContactBand eyebrow="Not sure whether this is the right door?" title="Start with a short fit call." description="I’ll look at what is already working, what is missing, and whether the sprint, ongoing consulting, or no engagement at all is the honest next step." ctaHref="/contact/?service=local-presence" ctaLabel="Talk through the fit" />
</BaseLayout>
