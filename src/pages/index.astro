---
import "@/styles/home-poster.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AgentTeam from "@/components/home/AgentTeam.astro";
import VoiceDemo from "@/components/home/VoiceDemo.astro";
import QuoteCalculator from "@/components/home/QuoteCalculator.astro";
import { offerLadder } from "@/data/offers";
import { systemsAuditHref } from "@/data/site";

const wishes = [
  "answer every call at 9pm",
  "reply to every email",
  "book appointments while you sleep",
  "chase every unpaid invoice",
  "post to social every week",
];

const replaced = [
  ["Front desk calls", "Phone & Text agent"],
  ["Email and support", "Email agent"],
  ["Billing", "Billing agent"],
  ["Calendar bookings", "Scheduling agent"],
  ["Missed texts", "Phone & Text agent"],
  ["Review chasing", "Reviews agent"],
  ["Lead spreadsheets", "Follow-up & CRM agent"],
  ["A stale website", "Website & Chat agent"],
];

const steps = [
  ["Week 0", "Audit and shadow", "I watch the real work with you: the calls, the inbox, the calendar, the way follow-up actually happens. We pick the platforms and write down one bottleneck."],
  ["Weeks 1–4", "One agent per job", "The build puts an agent on each platform your business already uses, plus the website. You see it working before launch."],
  ["Handoff", "You own it", "Training, the logins, and the system in your name. The Partner plan is optional after that. Cancel it and the system stays yours."],
];

const faqs = [
  ["What do I actually own?", "The website, the agents, and the accounts they run on are yours. The Partner plan is optional monitoring and changes. Skipping it, or canceling it later, does not take the system back."],
  ["Why one agent per platform?", "One chatbot asked to run the inbox, the phone, the reviews, and the invoices gets vague. Each agent has one job and one place it lives, so you can tell what it did."],
  ["How long does the build take?", "About 30 days after the audit. Week 0 is the shadow session. The next four weeks are the build. Then handoff and training."],
  ["What does it cost?", "The Systems Audit is $750–$1,500 and is credited toward the build. A custom operating system starts at $7,500. Larger businesses are usually $15,000–$25,000, half at kickoff and half at launch. The optional Partner plan is $1,500–$3,000 a month."],
  ["Will reviews be gated or bought?", "No. The reviews agent asks for a review and helps you reply. It does not hide unhappy customers, and it does not offer a reward for a star rating."],
  ["What if the result misses?", "We write one measured target during the audit. The promise: if new-lead response time is not under the minute target we agreed, your first Partner month is free. The number of minutes is set for your business, not copied from someone else’s."],
  ["Can I talk to it first?", "Yes. Use Talk to the demo on this page when the receptionist is connected. If that section says the demo is coming soon, book a live demo and I’ll walk you through the same conversation."],
];
---

<BaseLayout
  showFooter
  pageTitle="Custom AI systems for Raleigh small businesses"
  pageDescription="Ever wish your business could answer every call, follow up with every lead, and get more reviews — without you? Custom AI agents, one for each part of the business. Built in Raleigh. Yours to keep."
  socialImageAlt="Ever wish your business could answer every call, follow up with every lead, and get more reviews — without you?"
>
  <script is:inline>
    document.documentElement.classList.add("js");
  </script>
  <div class="poster-site">
    <section class="hero poster-shell" aria-labelledby="hero-title">
      <div class="hero-copy rise">
        <p class="kicker">Custom AI systems for Raleigh small businesses</p>
        <h1 id="hero-title">
          <span class="wish-static">Ever wish your business could answer every call, follow up with every lead, and get more reviews — without you?</span>
          <span class="wish-live" aria-hidden="true">
            <span class="wish-lead">Ever wish your business could</span>
            <span class="wish-slot"><span data-wish>{wishes[0]}</span></span>
            <span class="wish-tail">— without you?</span>
          </span>
        </h1>
        <p class="hero-intro">I build custom AI agents that do it for you. One for each part of your business. Built in Raleigh. Yours to keep.</p>
        <div class="hero-actions">
          <a class="poster-button poster-button-yellow" href={systemsAuditHref}>Book a Systems Audit</a>
          <a class="poster-button" href="#demo">Talk to the demo</a>
        </div>
      </div>
      <div class="hero-video rise rise-delay">
        <div class="video-frame" data-intro-frame>
          <button class="video-play" type="button" aria-label="Play the 15-second introduction, sound on">
            <img class="video-still" src="/video/raleigh-ai-guy-intro-poster.jpg" alt="" width="1280" height="720" decoding="async" />
          </button>
          <video controls playsinline preload="none" poster="/video/raleigh-ai-guy-intro-poster.jpg" aria-label="Watch the 15-second Raleigh AI Guy introduction">
            <source src="/video/raleigh-ai-guy-intro.mp4" type="video/mp4" />
            Your browser does not support video playback.
          </video>
        </div>
        <p class="video-caption"><span>Danny · 15 seconds</span><span>Press play · sound on</span></p>
      </div>
    </section>

    <section class="credential-strip poster-shell" aria-label="Background">
      <span>AI product engineer</span><i aria-hidden="true"></i><span>Educator</span><i aria-hidden="true"></i><span>Former service-business owner</span><i aria-hidden="true"></i><span>Raleigh, North Carolina</span>
    </section>

    <section class="replaces poster-shell" aria-labelledby="replaces-title">
      <div class="reveal">
        <p class="kicker">The jobs, not the software</p>
        <h2 id="replaces-title">What it replaces.</h2>
        <p class="section-lead">The same work a front desk, an office manager, or a late night of admin is already doing. Each job gets an agent that lives where that work already happens.</p>
      </div>
      <ul class="replace-grid reveal">
        {replaced.map(([job, agent]) => (
          <li><span>Handed to</span><strong>{job}</strong>{agent}</li>
        ))}
      </ul>
      <p class="payroll reveal">What do you pay someone to do all this? That’s just one of the agents.</p>
    </section>

    <AgentTeam />
    <VoiceDemo />

    <section class="steps poster-shell" id="how-it-works" aria-labelledby="steps-title">
      <div class="reveal">
        <p class="kicker">About 30 days</p>
        <h2 id="steps-title">How a system gets built.</h2>
        <p class="section-lead">We build an agent for each platform in your business. The order is the work, then the software.</p>
      </div>
      <ol class="step-grid">
        {steps.map(([when, title, copy], index) => (
          <li class="reveal" style={`--d:${index * 70}ms`}>
            <span class="kicker">{when}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="offers poster-shell" id="offer" aria-labelledby="offer-title">
      <div class="reveal">
        <p class="kicker">Starting prices, in writing</p>
        <h2 id="offer-title">The offer.</h2>
        <p class="section-lead">Three steps. The audit is the way in. The build is the system. The monthly plan is optional.</p>
      </div>
      <div class="offer-grid">
        {offerLadder.map((offer) => (
          <article class:list={["offer-card", "reveal", offer.featured && "is-featured"]}>
            <p class="kicker">{offer.kicker}</p>
            <h3>{offer.name}</h3>
            <p class="price">{offer.price}</p>
            <p>{offer.cadence}</p>
            <p>{offer.summary}</p>
            <ul>
              {offer.includes.map((item) => <li>{item}</li>)}
            </ul>
            {offer.note && <p class="offer-note">{offer.note}</p>}
            <a class="poster-button poster-button-yellow" href={`/contact/?package=${offer.id}#request`}>{offer.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="guarantee poster-shell" aria-labelledby="guarantee-title">
      <div class="guarantee-layout">
        <div class="reveal">
          <p class="kicker">One promise, one number</p>
          <h2 id="guarantee-title">A narrow guarantee.</h2>
          <p class="section-lead">I don’t guarantee “more leads” or a revenue jump. I guarantee one bottleneck we measure before the build.</p>
        </div>
        <div class="guarantee-card reveal">
          <p class="kicker">Written into the audit</p>
          <p>If we don’t get your new-lead response time under the minute target we agree in the audit, your first Partner month is free.</p>
          <p>The minutes are set for your business during the audit. TODO: Danny, keep that target in the audit notes. Don’t publish a single number here that wasn’t measured.</p>
        </div>
      </div>
    </section>

    <QuoteCalculator />

    <section class="proof poster-shell" id="case-study" aria-labelledby="proof-title">
      <div class="proof-layout">
        <div class="reveal">
          <p class="kicker">Proof</p>
          <h2 id="proof-title">Zim Zoom.</h2>
          <p class="section-lead">A custom command center turned scattered tools and manual handoffs into one operating view. The preview uses simulated records. It is not customer data.</p>
          <a class="proof-shot" href="/projects/zimzoom-photo-booth/">
            <img src="/case-study/01-owner-overview.png" alt="Zim Zoom operations command center preview using simulated, fictional records and no customer data." width="1440" height="1000" loading="lazy" decoding="async" />
          </a>
          <a class="poster-button" href="/projects/zimzoom-photo-booth/">View the case study</a>
        </div>
        <div>
          <article class="todo-card reveal">
            <p class="kicker">Results</p>
            <p>TODO: add only numbers Danny has approved for publication. None are shown here.</p>
            <p>TODO: if the public Zim Zoom site was a WordPress-to-Astro migration, say that here. The published case study describes the operations command center, so this card does not claim a platform migration.</p>
          </article>
          <article class="todo-card reveal">
            <p class="kicker">Testimonial</p>
            <p>TODO: a client quote, with permission to publish. This slot stays empty until then.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="local poster-shell" id="about" aria-labelledby="local-title">
      <div class="local-layout">
        <div class="reveal">
          <p class="kicker">Why local</p>
          <h2 id="local-title">See it before you buy it.</h2>
          <p class="section-lead">I’m in Raleigh. The shadow session is how the system learns your actual work. A template can’t watch you answer the phone.</p>
          <a class="poster-button" href="/about/">More about Danny</a>
        </div>
        <ul class="local-list reveal">
          <li><strong>In the room</strong> I’ll sit with you, or share the screen, and watch the task happen once before an agent is allowed to touch it.</li>
          <li><strong>A relationship, not a ticket</strong> You get me for the audit, the build, and the handoff. The work is not handed to a rotating inbox.</li>
          <li><strong>See it to believe it</strong> Talk to the demo. Then watch the agents on your own platforms before the final payment.</li>
        </ul>
      </div>
    </section>

    <section class="faq poster-shell" aria-labelledby="faq-title">
      <div class="reveal">
        <p class="kicker">Questions worth asking</p>
        <h2 id="faq-title">Before you book.</h2>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details class="reveal">
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="band poster-shell" aria-labelledby="final-title">
      <div class="reveal">
        <p class="kicker">Raleigh</p>
        <h2 id="final-title">Book a Systems Audit.</h2>
      </div>
      <a class="poster-button poster-button-yellow reveal" href={systemsAuditHref}>Book a Systems Audit</a>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ wishes }}>
  const wish = document.querySelector("[data-wish]");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (wish instanceof HTMLElement && !motion.matches && wishes.length > 1) {
    let index = 0;
    window.setInterval(() => {
      wish.classList.add("is-out");
      window.setTimeout(() => {
        index = (index + 1) % wishes.length;
        wish.textContent = wishes[index];
        wish.classList.remove("is-out");
      }, 180);
    }, 2600);
  }

  const frame = document.querySelector("[data-intro-frame]");
  const video = frame?.querySelector("video");
  const play = frame?.querySelector(".video-play");
  play?.addEventListener("click", () => {
    if (!(video instanceof HTMLVideoElement) || !frame) return;
    frame.classList.add("is-playing");
    video.play();
  });

  const nodes = document.querySelectorAll(".reveal");
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    nodes.forEach((node) => node.classList.add("is-in"));
  } else if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-in");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
    nodes.forEach((node) => observer.observe(node));
  } else {
    nodes.forEach((node) => node.classList.add("is-in"));
  }
</script>
