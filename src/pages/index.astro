---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { publishedPosts } from "@/lib/publishing";

const services = [
  {
    title: "Ongoing Consulting",
    price: "$2,500 / month",
    description: "One active business priority at a time, with practical strategy and hands-on implementation—not a pile of recommendations.",
    cta: "See the partnership",
    href: "/services/#consulting",
    icon: "headset",
  },
  {
    title: "Local Presence Sprint",
    price: "From $2,500",
    description: "A focused website, Google Business Profile, local SEO, and measurement foundation for an established local business.",
    cta: "See the sprint",
    href: "/small-business-growth/",
    icon: "people",
  },
  {
    title: "Custom Systems",
    price: "From $7,500",
    description: "Scoped automations, dashboards, and operating tools for valuable work that has outgrown the current process.",
    cta: "See custom systems",
    href: "/services/#custom-systems",
    icon: "workflow",
  },
];

const notesUrl = "/blog/";
const homePostIds = [
  "small-business-ai-strategy-30-days",
  "what-raleigh-ai-consultant-does-small-business",
  "do-i-need-ai",
];
const postsById = new Map(
  publishedPosts(await getCollection("posts")).map((post) => [post.id, post])
);
const homePosts = homePostIds.flatMap((id) => {
  const post = postsById.get(id);
  return post ? [post] : [];
});
const formatPostDate = (date: Date) => date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  minimal
  showFooter
  pageTitle="Practical AI for Raleigh Businesses — Raleigh AI Guy"
  pageDescription="Danny Sullivan helps Raleigh business owners through ongoing consulting, a focused local-presence sprint, and custom systems built around real work."
>
  <div class="poster-site">
    <header class="poster-header poster-shell">
      <a class="poster-brand" href="/" aria-label="Raleigh AI Guy home">
        <span>Raleigh</span>
        <span>AI Guy</span>
      </a>
      <span class="tape-note">Making AI useful</span>

      <nav class="desktop-nav" aria-label="Homepage navigation">
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#case-study">Case study</a>
        <a href="#notes">Writing</a>
        <a href="/contact/">Contact</a>
      </nav>

      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Mobile homepage navigation">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#case-study">Case study</a>
          <a href="#notes">Writing</a>
          <a href="/contact/">Contact</a>
        </nav>
      </details>
    </header>

    <main>
      <section class="hero poster-shell" aria-labelledby="hero-title">
        <div class="hero-copy poster-reveal">
          <p class="utility-label">Raleigh, North Carolina · Working with real businesses</p>
          <h1 id="hero-title">Practical AI <br />for the people <br /><span>doing the work.</span></h1>
          <p class="hero-intro">I help Raleigh business owners put AI to work through simpler workflows and practical automations—without the technical headaches.</p>
          <div class="hero-actions">
            <a class="poster-button poster-button-yellow" href="#services">See ways to work together <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/projects/">See what I’ve built <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="hero-video poster-reveal poster-reveal-delay">
          <div class="video-frame">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/video/raleigh-ai-guy-intro-poster.jpg"
              aria-label="Watch the 15-second Raleigh AI Guy introduction"
            >
              <source src="/video/raleigh-ai-guy-intro.mp4" type="video/mp4" />
              Your browser does not support video playback.
            </video>
          </div>
          <p class="video-caption"><span>Raleigh AI Guy · 15 seconds</span><strong>Press play · sound on</strong></p>
        </div>
      </section>

      <section class="credential-strip poster-shell" aria-label="Experience">
        <span>AI product engineer</span><i aria-hidden="true"></i><span>Educator</span><i aria-hidden="true"></i><span>Former service-business owner</span>
      </section>

      <section id="case-study" class="case-study poster-shell" aria-labelledby="case-study-title">
        <a class="case-visual" href="/projects/zimzoom-photo-booth/" aria-label="View the Zim Zoom operations command center case study">
          <img
            src="/case-study/01-owner-overview.png"
            alt="Zim Zoom operations command center preview using simulated, fictional records and no customer data."
            width="1440"
            height="1000"
            loading="eager"
            decoding="async"
          />
          <span><strong>Inside the build</strong> See the command center in action <i aria-hidden="true">→</i></span>
        </a>
        <div class="case-copy">
          <div class="case-label">
            <p>Featured case study</p>
            <h2 id="case-study-title">Zim Zoom</h2>
          </div>
          <p class="case-summary">A custom command center turned scattered tools and manual handoffs into one clear operating view.</p>
          <div class="case-metric">
            <p>Projected time savings</p>
            <strong>350–800</strong>
            <span>hours back per year</span>
          </div>
          <a class="poster-button" href="/projects/zimzoom-photo-booth/">View case study <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="about" class="about poster-shell poster-section">
        <div class="about-mark" aria-hidden="true">
          <svg viewBox="0 0 120 120" role="img">
            <path d="M75 102H29V76c0-8-7-12-12-18 0-28 18-45 43-45 27 0 44 18 44 42 0 14-6 23-15 29v18H75Z" />
            <circle cx="60" cy="51" r="16" />
            <path d="m60 28 3 8 8-3-2 9 9 2-7 6 6 7-9 1 1 9-9-4-4 8-4-9-8 3 2-9-9-2 7-6-6-7 9-1-1-9 9 4 4-8Z" />
          </svg>
        </div>
        <div>
          <p class="section-kicker">How I think about the work</p>
          <h2>AI should make the business easier to run.</h2>
          <p>I help you decide what is worth changing, choose the right approach, and make it useful for the people who actually do the work. Sometimes that means AI. Sometimes a clearer process or an ordinary tool is the better answer.</p>
          <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="services" class="services poster-shell poster-section" aria-labelledby="services-title">
        <div class="section-rule-heading">
          <h2 id="services-title">Ways to work with me</h2>
          <span aria-hidden="true"></span>
        </div>

        <div class="service-grid">
          {services.map((service, index) => (
            <article class="service-card">
              <div class="service-number">0{index + 1}</div>
              <div class="service-icon" aria-hidden="true">
                {service.icon === "headset" && (
                  <svg viewBox="0 0 96 72"><path d="M19 41V34a29 29 0 0 1 58 0v7" /><path d="M19 38H9v22h14V38h-4Zm58 0h10v22H73V38h4Z" /><path d="M73 59c-3 8-10 10-21 10" /><circle cx="47" cy="69" r="3" /></svg>
                )}
                {service.icon === "people" && (
                  <svg viewBox="0 0 96 72"><circle cx="29" cy="24" r="10" /><circle cx="67" cy="24" r="10" /><path d="M10 65V52c0-10 8-18 19-18s19 8 19 18v13M48 65V52c0-10 8-18 19-18s19 8 19 18v13" /><path d="M38 50h20" /></svg>
                )}
                {service.icon === "workflow" && (
                  <svg viewBox="0 0 96 72"><rect x="6" y="7" width="27" height="19" /><rect x="63" y="7" width="27" height="19" /><rect x="6" y="46" width="27" height="19" /><rect x="63" y="46" width="27" height="19" /><path d="M33 16h30m-7-6 7 6-7 6M63 56H33m7 6-7-6 7-6" /></svg>
                )}
              </div>
              <h3><span>{service.title}</span></h3>
              <strong class="service-price">{service.price}</strong>
              <p>{service.description}</p>
              <a href={service.href}>{service.cta} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section id="notes" class="notes-home poster-shell" aria-labelledby="notes-title">
        <div class="notes-header">
          <div class="notes-icon" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <div>
            <p class="section-kicker pink">From the field notes</p>
            <h2 id="notes-title">Useful places to start</h2>
            <p>Practical guides for choosing better AI opportunities and putting them to work.</p>
          </div>
          <a class="poster-button poster-button-yellow" href={notesUrl}>See all writing <span aria-hidden="true">→</span></a>
        </div>

        <div class="notes-grid">
          {homePosts.map((post, index) => (
            <article class="note-card">
              <a href={`/blog/posts/${post.id}`} aria-label={`Read: ${post.data.title}`}>
                <div class="note-image">
                  <Image
                    src={post.data.image.url}
                    alt={post.data.image.alt}
                    widths={[480, 720]}
                    sizes="(min-width: 900px) 24rem, (min-width: 560px) 50vw, 100vw"
                    loading="lazy"
                  />
                  <span aria-hidden="true">0{index + 1}</span>
                </div>
                <div class="note-copy">
                  <div class="note-meta">
                    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatPostDate(post.data.pubDate)}</time>
                    <span>{post.data.tags[0]?.replaceAll("-", " ")}</span>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <strong>Read the guide <span aria-hidden="true">→</span></strong>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>

    </main>
  </div>
</BaseLayout>

<style>
  :global(body) { background: #eee8d6; }

  .poster-site {
    --poster-ink: #17130f;
    --poster-paper: #f1ecdc;
    --poster-yellow: #f0df55;
    --poster-pink: #f43e8d;
    --poster-line: rgb(23 19 15 / 74%);
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    color: var(--poster-ink);
    background-color: var(--poster-paper);
    background-image:
      radial-gradient(circle at 15% 9%, rgb(255 255 255 / 52%) 0 1px, transparent 1.5px),
      radial-gradient(circle at 75% 42%, rgb(23 19 15 / 7%) 0 .7px, transparent 1px),
      repeating-linear-gradient(97deg, transparent 0 97px, rgb(23 19 15 / 2.4%) 98px 99px);
    background-size: 19px 19px, 13px 13px, auto;
    font-family: "Courier Prime", "IBM Plex Mono", monospace;
  }

  .poster-site::before {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(23 19 15 / 7%), transparent 1.4%, transparent 98.5%, rgb(23 19 15 / 8%)),
      linear-gradient(rgb(23 19 15 / 4%), transparent 1.2%, transparent 98.8%, rgb(23 19 15 / 7%));
    box-shadow: inset 0 0 90px rgb(23 19 15 / 8%);
    content: "";
    mix-blend-mode: multiply;
  }

  .poster-shell { width: min(calc(100% - 2.5rem), 72rem); margin-inline: auto; }

  .poster-header {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: 2.1rem 1.2rem;
    border-bottom: 2px solid var(--poster-ink);
  }

  .poster-brand {
    color: inherit;
    font-family: "Instrument Sans", sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -.07em;
    line-height: .76;
    text-transform: uppercase;
  }
  .poster-brand span { display: block; }

  .tape-note {
    display: inline-block;
    max-width: 10rem;
    padding: .48rem .72rem .38rem;
    background: var(--poster-yellow);
    box-shadow: 1px 2px 0 rgb(23 19 15 / 18%);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .06em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-1.7deg);
  }

  .desktop-nav { display: flex; justify-content: flex-end; gap: 1.45rem; }
  .desktop-nav a, .mobile-nav a {
    color: inherit;
    font-family: "Instrument Sans", sans-serif;
    font-size: .68rem;
    font-weight: 750;
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: .34rem;
    transition: text-decoration-color 140ms ease;
  }
  .desktop-nav a:hover { text-decoration-color: var(--poster-pink); }
  .mobile-nav { display: none; justify-self: end; }

  .hero {
    display: grid;
    min-height: 39rem;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, .95fr);
    align-items: stretch;
    border-bottom: 2px solid var(--poster-ink);
  }

  .hero-copy { z-index: 2; align-self: center; padding: 4.5rem 2rem 4rem 0; }
  .utility-label, .section-kicker {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .utility-label { margin-bottom: 1.4rem; }

  .hero h1, .poster-section h2, .notes h2 {
    font-family: "League Gothic", "Instrument Sans", sans-serif;
    font-weight: 400;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 46rem;
    font-size: clamp(4.7rem, 8.2vw, 8rem);
    letter-spacing: -.035em;
    line-height: .78;
  }
  .hero h1 span { color: var(--poster-pink); text-decoration: underline; text-decoration-thickness: .09em; text-underline-offset: .09em; }

  .hero-intro { max-width: 37rem; margin-top: 2.2rem; font-size: clamp(.96rem, 1.55vw, 1.2rem); font-weight: 700; line-height: 1.48; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 2rem; }
  .poster-button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 2px solid var(--poster-ink);
    padding: .75rem 1.15rem .62rem;
    color: inherit;
    background: var(--poster-paper);
    box-shadow: 4px 4px 0 var(--poster-ink);
    font-family: "Instrument Sans", sans-serif;
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .02em;
    text-transform: uppercase;
    transition: transform 130ms ease, box-shadow 130ms ease;
  }
  .poster-button:hover { transform: translate(2px, 2px) rotate(-.35deg); box-shadow: 2px 2px 0 var(--poster-ink); }
  .poster-button-yellow { background: var(--poster-yellow); }
  .poster-button-pink { background: var(--poster-pink); }

  .text-link { color: inherit; font-size: .76rem; font-weight: 700; text-decoration: underline; text-decoration-color: var(--poster-pink); text-decoration-thickness: 2px; text-underline-offset: .32rem; text-transform: uppercase; }

  .hero-video { position: relative; align-self: center; margin-left: clamp(.5rem, 2.5vw, 2.5rem); }
  .video-frame {
    position: relative;
    border: 2px solid var(--poster-ink);
    padding: .48rem;
    background: var(--poster-ink);
    box-shadow: 7px 7px 0 var(--poster-pink);
    transform: rotate(1deg);
  }
  .video-frame::before {
    position: absolute;
    top: -1.35rem;
    left: 50%;
    z-index: 2;
    width: 5.8rem;
    height: 2rem;
    background: rgb(240 223 85 / 88%);
    box-shadow: 0 1px 0 rgb(23 19 15 / 20%);
    content: "";
    transform: translateX(-50%) rotate(-2deg);
  }
  .hero-video video { display: block; width: 100%; aspect-ratio: 16 / 9; border: 1px solid rgb(255 255 255 / 35%); background: var(--poster-ink); object-fit: cover; }
  .hero-video video:focus-visible { outline: 4px solid var(--poster-yellow); outline-offset: 3px; }
  .video-caption { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 1rem .25rem 0; font-size: .6rem; font-weight: 800; letter-spacing: .05em; line-height: 1.3; text-transform: uppercase; }
  .video-caption strong { padding: .3rem .45rem .22rem; background: var(--poster-yellow); font-family: "Instrument Sans", sans-serif; font-size: .58rem; font-weight: 850; transform: rotate(-1deg); }

  .credential-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(.75rem, 2.5vw, 2rem);
    padding-block: 1.35rem;
    border-bottom: 2px solid var(--poster-ink);
    font-family: "Instrument Sans", sans-serif;
    font-size: clamp(.62rem, 1vw, .8rem);
    font-weight: 800;
    letter-spacing: .04em;
    text-align: center;
    text-transform: uppercase;
  }
  .credential-strip i { width: .42rem; height: .42rem; border-radius: 50%; background: var(--poster-pink); }

  .poster-section { padding-block: clamp(4.5rem, 8vw, 7rem); }
  .about { display: grid; grid-template-columns: minmax(12rem, .45fr) 1fr; align-items: center; gap: clamp(2rem, 7vw, 6rem); border-bottom: 2px solid var(--poster-ink); }
  .about-mark { display: grid; min-height: 15rem; place-items: center; border-right: 1.5px dashed var(--poster-line); }
  .about-mark svg { width: min(80%, 13rem); fill: none; stroke: var(--poster-ink); stroke-linecap: square; stroke-linejoin: bevel; stroke-width: 3.2; }
  .section-kicker { margin-bottom: .8rem; }
  .section-kicker.pink { color: var(--poster-pink); }
  .about h2 { max-width: 48rem; font-size: clamp(3.2rem, 6.2vw, 5.8rem); letter-spacing: -.025em; line-height: .86; }
  .about p:not(.section-kicker) { max-width: 46rem; margin-top: 1.5rem; font-size: 1rem; font-weight: 700; line-height: 1.58; }
  .about .text-link { display: inline-flex; margin-top: 1.5rem; }

  .services { border-bottom: 2px solid var(--poster-ink); }
  .section-rule-heading { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.2rem; }
  .section-rule-heading h2 { font-size: clamp(3rem, 5.5vw, 5rem); letter-spacing: -.02em; line-height: .9; }
  .section-rule-heading span { height: 2px; background: var(--poster-ink); }

  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2.4rem; border-block: 2px solid var(--poster-ink); }
  .service-card { position: relative; display: flex; min-height: 27rem; flex-direction: column; padding: 2rem 1.8rem 1.7rem; }
  .service-card + .service-card { border-left: 1.5px dashed var(--poster-line); }
  .service-number { position: absolute; top: .8rem; right: 1rem; color: rgb(23 19 15 / 28%); font-family: "League Gothic", sans-serif; font-size: 2.5rem; }
  .service-icon { display: grid; min-height: 8.5rem; place-items: center; }
  .service-icon svg { width: 6.4rem; fill: none; stroke: var(--poster-ink); stroke-linecap: square; stroke-linejoin: miter; stroke-width: 2.5; }
  .service-card h3 { font-family: "Instrument Sans", sans-serif; font-size: 1rem; font-weight: 850; text-transform: uppercase; }
  .service-card h3 span { display: inline; padding: .26rem .48rem .2rem; background: var(--poster-yellow); box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .service-price { display: block; margin-top: 1.15rem; color: var(--poster-pink); font-family: "League Gothic", sans-serif; font-size: 2rem; font-weight: 400; letter-spacing: .01em; line-height: 1; text-transform: uppercase; }
  .service-card p { margin-top: 1rem; font-size: .86rem; font-weight: 700; line-height: 1.48; }
  .service-card > a { margin-top: auto; padding-top: 1.5rem; color: var(--poster-pink); font-family: "Instrument Sans", sans-serif; font-size: .72rem; font-weight: 850; text-decoration: underline; text-underline-offset: .3rem; text-transform: uppercase; }

  .case-study { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(19rem, .72fr); border: 2px solid var(--poster-ink); margin-block: clamp(2.5rem, 5vw, 4.5rem) 1.5rem; background: var(--poster-paper); box-shadow: 6px 6px 0 var(--poster-ink); }
  .case-visual { position: relative; min-width: 0; overflow: hidden; border-right: 1.5px dashed var(--poster-line); padding: .7rem; background: var(--poster-ink); }
  .case-visual img { display: block; width: 100%; height: 100%; min-height: 29rem; border: 1px solid rgb(255 255 255 / 35%); object-fit: cover; object-position: left top; transition: filter 180ms ease, transform 180ms ease; }
  .case-visual > span { position: absolute; right: 1.5rem; bottom: 1.5rem; display: grid; max-width: 15rem; padding: .8rem 1rem .7rem; border: 2px solid var(--poster-ink); background: var(--poster-yellow); box-shadow: 4px 4px 0 var(--poster-ink); color: var(--poster-ink); font-size: .68rem; font-style: normal; font-weight: 700; line-height: 1.35; text-transform: uppercase; transform: rotate(-1deg); }
  .case-visual > span strong { font-family: "Instrument Sans", sans-serif; font-size: .9rem; font-weight: 850; }
  .case-visual > span i { position: absolute; right: .65rem; bottom: .4rem; color: var(--poster-pink); font-family: "Instrument Sans", sans-serif; font-size: 1.1rem; font-style: normal; font-weight: 900; }
  .case-visual:hover img { filter: saturate(1.08) contrast(1.03); transform: scale(1.008); }
  .case-copy { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 3vw, 2.5rem); }
  .case-label { padding-bottom: 1.4rem; border-bottom: 1.5px dashed var(--poster-line); }
  .case-label p, .case-label h2 { color: var(--poster-pink); font-family: "Instrument Sans", sans-serif; font-size: .7rem; font-weight: 850; line-height: 1; text-transform: uppercase; }
  .case-label h2 { margin-top: .4rem; color: var(--poster-ink); font-family: "League Gothic", sans-serif; font-size: clamp(3.8rem, 6vw, 5.4rem); font-weight: 400; letter-spacing: -.025em; }
  .case-summary { margin-top: 1.5rem; font-size: .84rem; font-weight: 700; line-height: 1.55; }
  .case-metric { display: grid; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1.5px dashed var(--poster-line); align-content: center; }
  .case-metric p { font-size: .65rem; font-weight: 700; text-transform: uppercase; }
  .case-metric strong { font-family: "League Gothic", sans-serif; font-size: clamp(4.8rem, 7vw, 6.8rem); font-weight: 400; letter-spacing: -.035em; line-height: .83; }
  .case-metric span { justify-self: start; padding: .28rem .6rem .2rem; background: var(--poster-yellow); font-family: "Instrument Sans", sans-serif; font-size: .78rem; font-weight: 850; text-transform: uppercase; transform: rotate(-.6deg); }
  .case-copy > .poster-button { align-self: flex-start; margin-top: 1.6rem; font-size: .7rem; }

  .notes-home { margin-block: clamp(3.5rem, 6vw, 5.5rem) 1.5rem; }
