---
interface Props {
  venue?: string;
  label?: string;
  tilt?: 'left' | 'right' | 'none';
}

const { venue = 'YOUR LOGO HERE', label = 'TODAY AT', tilt = 'none' } = Astro.props;
const partners = Array.from({ length: 6 }, () => 'YOUR BUSINESS HERE');
---

<div class:list={[
  'cb-board relative overflow-hidden border-[7px] border-[#17130f] bg-[#17130f] shadow-[10px_12px_0_rgb(23_19_15_/_18%)]',
  tilt === 'left' && '-rotate-2',
  tilt === 'right' && 'rotate-2',
] }>
  <div class="flex h-[75%] flex-col items-center px-5 pt-7 text-center text-[#f7f1df]">
    <p class="text-[.54rem] font-bold tracking-[.24em] text-[#f0df55]">{label}</p>
    <h3 class="mt-2 font-editorial text-[clamp(1.85rem,4.5vw,3rem)] leading-[.85]">{venue}</h3>
    <div class="mt-5 h-[2px] w-14 bg-[#f43e8d]"></div>
    <p class="mt-8 -rotate-1 text-sm leading-8 opacity-75">today's specials<br/>fresh • local • made here<br/><br/>events • updates • announcements</p>
  </div>
  <div class="absolute inset-x-0 bottom-[7%] grid h-[18%] grid-cols-3 gap-[2px] bg-[#17130f] px-[3px] pt-[3px]">
    {partners.map((business) => (
      <div class="grid place-items-center border border-[#f7f1df]/80 bg-[#17130f] px-1 text-center text-[#f7f1df]">
        <strong class="block -rotate-1 font-editorial text-[.55rem] font-normal leading-tight">{business}</strong>
      </div>
    ))}
  </div>
  <div class="absolute inset-x-[3px] bottom-[3px] flex h-[7%] items-center bg-[#17130f] px-2 text-left text-[#f7f1df]">
    <span class="grid aspect-square h-[70%] place-items-center border border-[#f0df55] bg-[#f0df55] font-editorial text-lg leading-none text-[#17130f] shadow-[2px_2px_0_#f43e8d]">AI</span>
    <span class="ml-1 hidden text-[.22rem] font-bold uppercase leading-tight text-white/65 min-[360px]:block">Raleigh<br/>AI Guy</span>
    <span class="ml-auto min-w-0 text-center leading-none"><strong class="block truncate font-editorial text-[clamp(.7rem,2.2vw,1rem)] uppercase">Community Board</strong><small class="mt-1 block truncate text-[.27rem] font-bold uppercase tracking-[.06em] text-white/75">Scan to meet the sponsors</small></span>
    <span class="ml-auto h-[65%] border-l border-white/55 pl-2"><span class="cb-qr grid aspect-square h-full place-items-center border-2 border-white bg-white text-[.28rem] font-black text-[#17130f]">QR</span></span>
  </div>
</div>

<style>
  .cb-board { aspect-ratio: 2 / 3; }
  .cb-qr { background-image:repeating-conic-gradient(#17130f 0 25%,#fff 0 50%); background-position:0 0; background-size:5px 5px; }
  .cb-qr { text-shadow:0 0 2px #fff,0 0 3px #fff; }
</style>
