---
const inventory = [
  { area: 'North Raleigh', venue: 'Restaurant', total: 8, open: 3, note: 'Family dining corridor · dinner and weekend traffic' },
  { area: 'Downtown', venue: 'Coffee shop', total: 6, open: 4, note: 'Walkable district · weekday regulars' },
  { area: 'Five Points', venue: 'Bar & grill', total: 8, open: 0, note: 'Neighborhood gathering spot · evenings and weekends' },
  { area: 'Cary', venue: 'Pizza restaurant', total: 8, open: 5, note: 'Family-focused retail center · lunch and dinner' },
];
---

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
  {inventory.map((item) => (
    <article class="flex min-h-72 flex-col border-2 border-[var(--brand-ink)] bg-[var(--brand-surface)] p-5 shadow-[4px_4px_0_var(--brand-ink)]">
      <div class="flex items-start justify-between gap-2">
        <span class="bg-[var(--brand-yellow)] px-2 py-1 text-[.58rem] font-bold uppercase">Demo inventory</span>
        <span class="text-[.58rem] font-bold uppercase text-[var(--brand-muted)]">{item.open ? `${item.open} open` : 'Waitlist'}</span>
      </div>
      <p class="mt-8 text-xs font-bold uppercase tracking-[.1em] text-[var(--brand-muted)]">{item.area}</p>
      <h3 class="mt-2 font-editorial text-3xl leading-none uppercase">{item.venue}</h3>
      <p class="mt-4 text-xs leading-5 text-[var(--brand-muted)]">{item.note}</p>
      <div class="mt-auto pt-7">
        <div class="h-2 border border-[var(--brand-ink)] bg-[var(--brand-paper)]"><div class="h-full bg-[var(--brand-orange)]" style={`width:${((item.total - item.open) / item.total) * 100}%`}></div></div>
        <p class="mt-2 text-[.62rem] font-bold uppercase">{item.total} sponsor positions · {item.open ? `${item.open} remaining` : 'join waitlist'}</p>
      </div>
    </article>
  ))}
</div>
