---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const year = new Date().getFullYear();
const links = [
  { text: "Contact", href: "/contact/" },
  { text: "Services", href: "/services/" },
  { text: "Local Presence Sprint", href: "/small-business-growth/" },
  { text: "Community Boards", href: "/community-boards/" },
  { text: "About", href: "/about/" },
  { text: "Work", href: "/projects/" },
  { text: "Writing", href: "/blog/" },
  { text: "Privacy", href: "/privacy/" },
];

const socialLinks = [
  { name: "Instagram", href: "https://www.instagram.com/raleigh_ai_guy", icon: "instagram" },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/raleigh-ai-guy/", icon: "linkedin" },
  { name: "YouTube", href: "https://www.youtube.com/@raleigh_ai_guy", icon: "youtube" },
];
---

<footer class="print-footer">
  <Wrapper variant="wide">
    <div class="print-footer-cta">
      <div>
        <p class="print-kicker">Start with the work itself</p>
        <h2>Tell me what you’re trying to make easier.</h2>
      </div>
      <a href="/contact/">Work with Danny <span aria-hidden="true">→</span></a>
    </div>

    <div class="print-footer-bottom">
      <div>
        <strong>Raleigh AI Guy</strong>
        <p>Making AI useful for the people who run real businesses.</p>
        <a class="email" href="/contact/">One form for everything →</a>
        <nav class="social-links" aria-label="Social media">
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer" aria-label={`Follow Raleigh AI Guy on ${link.name}`} title={link.name}>
              {link.icon === "instagram" && (
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.417-.923 3.9 3.9 0 0 0 .922-1.417c.198-.51.333-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.174-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h1.434c1.986 0 2.22.007 3.005.043.725.033 1.119.154 1.381.256.348.135.596.297.857.558.262.262.424.51.559.857.102.262.223.657.256 1.382.036.785.043 1.02.043 3.005s-.007 2.22-.043 3.005c-.033.725-.154 1.119-.256 1.381a2.5 2.5 0 0 1-.559.857 2.5 2.5 0 0 1-.857.559c-.262.102-.656.223-1.381.256-.785.036-1.02.043-3.005.043s-2.22-.007-3.005-.043c-.725-.033-1.119-.154-1.381-.256a2.5 2.5 0 0 1-.857-.559 2.5 2.5 0 0 1-.558-.857c-.102-.262-.223-.656-.256-1.381-.036-.785-.043-1.02-.043-3.005s.007-2.22.043-3.005c.033-.725.154-1.12.256-1.382.135-.347.297-.595.558-.857.262-.261.51-.423.857-.558.262-.102.656-.223 1.381-.256.687-.031.95-.04 2.288-.041zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92M8 3.892a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334" />
                </svg>
              )}
              {link.icon === "linkedin" && (
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.213c.837 0 1.358-.554 1.358-1.248-.015-.71-.52-1.249-1.342-1.249-.822 0-1.358.54-1.358 1.249 0 .694.52 1.248 1.327 1.248zm3.052 8.213h2.4V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225" />
                </svg>
              )}
              {link.icon === "youtube" && (
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.043c0 .182-.01 1.07-.074 1.984l-.008.105-.022.26-.01.104c-.048.52-.119 1.023-.22 1.402a2.01 2.01 0 0 1-1.415 1.42c-1.16.312-5.488.335-6.11.336h-.142c-.314 0-1.61-.006-2.97-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.126-.046-2.2-.117-2.76-.268a2.01 2.01 0 0 1-1.415-1.42c-.101-.38-.172-.883-.22-1.402l-.01-.104-.022-.26-.008-.104A31 31 0 0 1 0 7.613v-.03c0-.19.008-1.063.074-1.977l.008-.104.022-.26.01-.104c.048-.52.119-1.023.22-1.402a2.01 2.01 0 0 1 1.415-1.42c.56-.15 1.634-.222 2.76-.268l.171-.007.172-.006.086-.003.171-.007A99 99 0 0 1 7.858 2zM6.4 5.209v4.818l4.157-2.408z" />
                </svg>
              )}
            </a>
          ))}
        </nav>
      </div>
      <nav aria-label="Footer navigation">
        {links.map((link) => <a href={link.href}>{link.text}</a>)}
      </nav>
      <p class="copyright">© {year} Danny Sullivan · Raleigh, North Carolina</p>
    </div>
  </Wrapper>
</footer>

<style>
  .print-footer { position: relative; z-index: 1; color: var(--brand-ink); background: var(--brand-paper); }
  .print-footer-cta { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; padding-block: clamp(4rem, 7vw, 6.5rem); border-top: 2px solid var(--brand-ink); }
  .print-kicker { margin-bottom: .7rem; font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .print-footer h2 { max-width: 50rem; font-family: "League Gothic", sans-serif; font-size: clamp(3.7rem, 7vw, 6.7rem); font-weight: 400; letter-spacing: -.025em; line-height: 1.05; text-decoration: underline; text-decoration-color: var(--brand-orange); text-decoration-thickness: .07em; text-underline-offset: .09em; text-transform: uppercase; }
  .print-footer-cta > a { display: inline-flex; min-width: 14rem; min-height: 3.3rem; align-items: center; justify-content: space-between; gap: 1.5rem; border: 2px solid var(--brand-ink); padding: .75rem 1rem .62rem; color: var(--brand-ink); background: var(--brand-orange); box-shadow: 4px 4px 0 var(--brand-ink); font-family: "Instrument Sans", sans-serif; font-size: .76rem; font-weight: 850; text-transform: uppercase; transition: transform 130ms ease, box-shadow 130ms ease; }
  .print-footer-cta > a:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--brand-ink); }
  .print-footer-bottom { display: grid; grid-template-columns: 1fr auto; gap: 2rem; padding-block: 2.5rem; border-top: 2px solid var(--brand-ink); }
  .print-footer strong { font-family: "Instrument Sans", sans-serif; font-size: 1.15rem; font-weight: 850; text-transform: uppercase; }
  .print-footer-bottom p { margin-top: .45rem; font-size: .7rem; font-weight: 700; line-height: 1.45; }
  .email { display: inline-flex; margin-top: 1rem; color: inherit; font-size: .72rem; font-weight: 700; text-decoration: underline; text-decoration-color: var(--brand-orange); text-underline-offset: .3rem; }
  .print-footer nav { display: grid; grid-template-columns: repeat(2, auto); align-content: start; gap: .55rem 1.4rem; }
  .print-footer nav a { color: inherit; font-family: "Instrument Sans", sans-serif; font-size: .64rem; font-weight: 800; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .25rem; text-transform: uppercase; }
  .print-footer nav a:hover { text-decoration-color: var(--brand-orange); }
  .print-footer .social-links { display: flex; grid-template-columns: none; align-items: center; gap: .65rem; margin-top: 1.25rem; }
  .print-footer .social-links a { display: inline-flex; width: 2.35rem; height: 2.35rem; align-items: center; justify-content: center; border: 2px solid var(--brand-ink); color: var(--brand-ink); background: var(--brand-surface); box-shadow: 3px 3px 0 var(--brand-ink); text-decoration: none; transition: transform 130ms ease, background-color 130ms ease, box-shadow 130ms ease; }
  .print-footer .social-links a:hover { background: var(--brand-orange); transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--brand-ink); }
  .print-footer .social-links a:focus-visible { outline: 3px solid var(--brand-orange); outline-offset: 3px; }
  .print-footer .social-links svg { width: 1rem; height: 1rem; fill: currentColor; }
  .copyright { grid-column: 1 / -1; margin-top: 1rem !important; text-transform: uppercase; }
  @media (max-width: 720px) {
    .print-footer-cta { grid-template-columns: 1fr; align-items: start; }
    .print-footer-bottom { grid-template-columns: 1fr; }
    .print-footer nav { justify-content: start; }
  }
</style>
