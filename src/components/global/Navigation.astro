---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { leakAuditHref, primaryNav } from "@/data/site";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => !href.startsWith("/#") && (currentPath === href || currentPath.startsWith(href));
---

<header class="print-header">
  <Wrapper variant="wide">
    <div class="print-header-inner">
      <a href="/" class="print-brand" aria-label="Raleigh AI Guy home">
        <span>Raleigh</span><span>AI Guy</span>
      </a>
      <span class="print-tape">Making AI useful</span>

      <nav class="print-links" aria-label="Main navigation">
        {primaryNav.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.text}</a>
        ))}
        <a href={leakAuditHref} aria-current={currentPath.startsWith("/contact/") ? "page" : undefined} class="print-contact">Book a Leak Audit →</a>
      </nav>

      <details class="print-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          {primaryNav.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.text}</a>
          ))}
          <a href={leakAuditHref} aria-current={currentPath.startsWith("/contact/") ? "page" : undefined}>Book a Leak Audit</a>
        </nav>
      </details>
    </div>
  </Wrapper>
</header>

<style>
  .print-header { position: relative; z-index: 25; }
  .print-header-inner { display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 1.2rem; padding-block: 1.5rem .9rem; border-bottom: 2px solid var(--brand-ink); }
  .print-brand { color: var(--brand-ink); font-family: "Instrument Sans", sans-serif; font-size: clamp(1.35rem, 2.2vw, 2rem); font-weight: 850; letter-spacing: -.07em; line-height: .75; text-transform: uppercase; }
  .print-brand span { display: block; }
  .print-tape { justify-self: start; max-width: 8.5rem; padding: .42rem .6rem .34rem; background: var(--brand-yellow); box-shadow: 2px 2px 0 rgb(23 19 15 / 18%); color: var(--brand-ink); font-size: .75rem; font-weight: 800; letter-spacing: .04em; line-height: 1.25; text-align: center; text-transform: uppercase; transform: rotate(-1.5deg); }
  .print-links { display: flex; align-items: center; justify-content: flex-end; gap: .85rem; }
  .print-links a, .print-menu a { color: var(--brand-ink); font-family: "Instrument Sans", sans-serif; font-size: .75rem; font-weight: 800; letter-spacing: .03em; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .35rem; text-transform: uppercase; }
  .print-links a:hover, .print-links a[aria-current="page"] { text-decoration-color: var(--brand-pink-text); }
  .print-links .print-contact { border: 2px solid var(--brand-ink); padding: .65rem .8rem .55rem; background: var(--brand-yellow); box-shadow: 3px 3px 0 var(--brand-ink); text-decoration: none; transition: transform 130ms ease, box-shadow 130ms ease; }
  .print-links .print-contact:hover { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--brand-ink); }
  .print-menu { position: relative; display: none; justify-self: end; }
  .print-menu summary { display: flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: flex-end; cursor: pointer; font-family: "Instrument Sans", sans-serif; font-size: .75rem; font-weight: 800; list-style: none; text-transform: uppercase; }
  .print-menu summary::-webkit-details-marker { display: none; }
  .print-menu nav { position: absolute; top: 2.75rem; right: 0; z-index: 30; display: grid; min-width: 13rem; border: 2px solid var(--brand-ink); padding: .5rem 1rem; background: var(--brand-yellow); box-shadow: 4px 4px 0 var(--brand-ink); }
  .print-menu nav a { display: flex; min-height: 44px; align-items: center; }

  @media (max-width: 1180px) {
    .print-header-inner { grid-template-columns: auto 1fr auto; gap: .9rem; }
    .print-links { display: none; }
    .print-menu { display: block; }
  }
  @media (max-width: 430px) {
    .print-header-inner { padding-top: 1.25rem; }
    .print-brand { font-size: 1.4rem; }
    .print-tape { max-width: 7.2rem; padding-inline: .42rem; font-size: .7rem; }
  }
</style>
